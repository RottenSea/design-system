---
import { Image } from "astro:assets";
/**
 * An MDX post's `img`. An image the directive plugin marked becomes a Figure captioned with its
 * title; one inside a line stays inline, since a <figure> cannot sit in a paragraph.
 */
import type { ImageMetadata } from "astro";
import Figure from "./Figure.astro";

type Props = Record<string, unknown> & {
  src: ImageMetadata | string;
  alt?: string;
  title?: string;
};

const { src, alt = "", title, ...rest } = Astro.props;
// A figure is no wider than --container-reading, so the browser picks a width for that.
const sizes = "(min-width: 720px) 680px, 100vw";
// The mark's name depends on which of Astro's image paths the image took.
const figure = "dataDsFigure" in rest || "data-ds-figure" in rest;
// A ::video poster, sized by the VideoEmbed around it.
const poster = "dataDsPoster" in rest || "data-ds-poster" in rest;
---

{
  poster ? (
    typeof src === "string" ? (
      <img src={src} alt="" loading="lazy" />
    ) : (
      <Image src={src} alt="" />
    )
  ) : figure ? (
    <Figure src={src} alt={alt} caption={title || undefined} sizes={sizes} />
  ) : typeof src === "string" ? (
    <img src={src} alt={alt} title={title} loading="lazy" />
  ) : (
    <Image src={src} alt={alt} title={title} />
  )
}
