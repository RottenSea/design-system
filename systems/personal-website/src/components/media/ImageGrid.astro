---
/**
 * Several images as one block. Fixed column count and a fixed aspect ratio, so a row never goes
 * ragged; tiles crop rather than letterbox. Clicking a tile opens the whole image over the page.
 * A tile with no `src` draws the system's striped placeholder with its alt text in the mono face,
 * so a page can be laid out before the photographs exist.
 *
 * Ported from the handoff's ImageGrid.jsx with the same props, with two changes. `lightbox`
 * turns on Figure's medium-zoom instead of the handoff's Lightbox, which steps from image to
 * image; posts open one image at a time. And the tiles can be Figure children instead of
 * `items`, which is what the :::gallery directive writes; `ratio` and `columns` still apply.
 */
import type { ImageMetadata } from "astro";
import Figure from "./Figure.astro";

interface Item {
  /** Omit to draw the striped placeholder with `alt` as its label. */
  src?: ImageMetadata | string;
  alt?: string;
  /** One line under the tile. */
  caption?: string;
  /** Overrides the grid ratio for this tile: "1/1", "3/4". */
  ratio?: string;
  /** cover (default) crops the image to the tile; contain fits it inside. */
  fit?: "cover" | "contain";
  /** Needed with a URL `src`. */
  width?: number;
  height?: number;
}

interface Props {
  items?: Item[];
  /** Column count. Two to four. */
  columns?: number | string;
  /** Aspect ratio of every tile. */
  ratio?: string;
  /** Gap between tiles. */
  gap?: string;
  /** Opens a tile larger on click. */
  lightbox?: boolean;
  tone?: "cream" | "dark";
  class?: string;
}

const {
  items,
  columns = 3,
  ratio = "4/3",
  gap = "var(--space-sm)",
  lightbox = true,
  tone = "cream",
  class: className
} = Astro.props;

const style = `--ds-columns: ${Number(columns) || 3}; --ds-ratio: ${ratio}; --ds-gap: ${gap}`;
const cellStyle = (item: Item) =>
  [item.ratio && `--ds-ratio: ${item.ratio}`, item.fit && `--ds-fit: ${item.fit}`].filter(Boolean).join("; ") ||
  undefined;
---

<div class:list={["ds-image-grid", { "ds-image-grid--dark": tone === "dark" }, className]} style={style}>
  {
    items
      ? items.map((item) => (
          <div class="ds-image-grid__cell" style={cellStyle(item)}>
            {item.src ? (
              <Figure
                src={item.src}
                alt={item.alt ?? ""}
                caption={item.caption}
                zoom={lightbox}
                width={item.width}
                height={item.height}
              />
            ) : (
              <figure class="ds-image-grid__stub-figure">
                <span class="ds-image-grid__stub">{item.alt || "image"}</span>
                {item.caption && <figcaption class="ds-image-grid__caption">{item.caption}</figcaption>}
              </figure>
            )}
          </div>
        ))
      : <slot />
  }
</div>

<style>
  .ds-image-grid {
    display: grid;
    gap: var(--ds-gap);
    grid-template-columns: repeat(var(--ds-columns), minmax(0, 1fr));
    margin: var(--space-lg) 0;
    max-width: var(--container-reading);
  }

  /* The tiles are Figures, whose elements belong to Figure, so they are reached through :global. */
  .ds-image-grid :global(.ds-figure),
  .ds-image-grid__stub-figure {
    margin: 0;
  }

  .ds-image-grid :global(.ds-figure__frame),
  .ds-image-grid__stub {
    aspect-ratio: var(--ds-ratio);
    background-color: var(--surface-card);
    border-radius: var(--radius-lg);
  }

  .ds-image-grid :global(.ds-figure__img) {
    height: 100%;
    object-fit: var(--ds-fit, cover);
  }

  .ds-image-grid :global(.ds-figure__caption),
  .ds-image-grid__caption {
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: var(--caption-size);
    line-height: var(--caption-lh);
    margin-top: var(--space-xs);
  }

  .ds-image-grid__stub {
    align-items: center;
    background: repeating-linear-gradient(
      135deg,
      var(--surface-card) 0px,
      var(--surface-card) 8px,
      var(--surface-soft) 8px,
      var(--surface-soft) 16px
    );
    box-sizing: border-box;
    color: var(--text-muted);
    display: flex;
    font-family: var(--font-mono);
    font-size: var(--caption-size);
    justify-content: center;
    padding: var(--space-xs);
    text-align: center;
  }

  .ds-image-grid--dark :global(.ds-figure__frame) {
    background-color: var(--surface-dark-elevated);
  }

  .ds-image-grid--dark :global(.ds-figure__caption),
  .ds-image-grid--dark .ds-image-grid__caption {
    color: var(--text-on-dark-soft);
  }
</style>
