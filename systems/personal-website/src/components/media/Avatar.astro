---
import { Image } from "astro:assets";
/** A circular portrait, or the name's initials without a photograph. */
import type { ImageMetadata } from "astro";

const SIZES = { sm: 28, md: 40, lg: 64 };

interface Props {
  /** The photograph, cropped to a circle. */
  src?: ImageMetadata | string;
  alt?: string;
  /** Gives the initials when there is no photograph. */
  name?: string;
  /** 28, 40 or 64px, or a number of pixels. */
  size?: keyof typeof SIZES | number;
  /** The surface it sits on, which sets the initials' fill. */
  tone?: "cream" | "dark";
  class?: string;
}

const {
  src,
  alt = "",
  name = "",
  size = "md",
  tone = "cream",
  class: className
} = Astro.props;
const px = typeof size === "number" ? size : SIZES[size];
const initials = name
  .trim()
  .split(/\s+/)
  .slice(0, 2)
  .map((word) => [...word][0] ?? "")
  .join("")
  .toUpperCase();
---

<span
  class:list={["ds-avatar", { "ds-avatar--dark": tone === "dark" }, className]}
  style={`--ds-avatar-size: ${px}px`}
  role={src ? undefined : "img"}
  aria-label={src ? undefined : name || undefined}
>
  {
    src ? (
      typeof src === "string" ? (
        <img src={src} alt={alt} width={px} height={px} />
      ) : (
        <Image src={src} alt={alt} width={px} height={px} densities={[1, 2]} fit="cover" />
      )
    ) : (
      <span aria-hidden="true">{initials}</span>
    )
  }
</span>

<style>
  .ds-avatar {
    align-items: center;
    background: var(--surface-card);
    border-radius: var(--radius-full);
    color: var(--text-ink);
    display: inline-flex;
    flex: 0 0 auto;
    font-family: var(--font-sans);
    font-size: calc(var(--ds-avatar-size) * 0.36);
    font-weight: 500;
    height: var(--ds-avatar-size);
    justify-content: center;
    line-height: 1;
    overflow: hidden;
    width: var(--ds-avatar-size);
  }

  .ds-avatar--dark {
    background: var(--surface-dark-elevated);
    color: var(--text-on-dark);
  }

  .ds-avatar img {
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }
</style>
