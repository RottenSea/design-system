---
import { getImage, Image } from "astro:assets";
/**
 * One image in a post with an optional caption; it opens larger on click. A blurred 16px copy
 * shows while a local image loads. The zoom starts at once from the image as the page shows it,
 * crop and corners included, and grows to the whole image, its size known from the original's;
 * the smallest larger copy that covers the screen replaces it once loaded, and loading starts on
 * hover or focus. Closing runs the same way back.
 */
import type { ImageMetadata } from "astro";
import { placeholderOf } from "./placeholder";

interface Props {
  /** An imported image, which gets the placeholder and a larger copy to zoom into, or a URL. */
  src: ImageMetadata | string;
  /** Describes the image. Empty only for a decorative image. */
  alt: string;
  /** One line under the image. */
  caption?: string;
  /** Opens the image larger on click. */
  zoom?: boolean;
  /** Shows the blurred copy while a local, opaque image loads. */
  placeholder?: boolean;
  /** Needed for a URL; an imported image knows its size. */
  width?: number;
  height?: number;
  /** Passed to Astro's <Image> for an imported image. */
  widths?: number[];
  sizes?: string;
  loading?: "lazy" | "eager";
  class?: string;
}

const ZOOM_WIDTHS = [1200, 1800, 2400];

const {
  src,
  alt,
  caption,
  zoom = true,
  placeholder = true,
  width,
  height,
  widths,
  sizes,
  loading = "lazy",
  class: className
} = Astro.props;

const local = typeof src !== "string";
const stand = local && placeholder ? await placeholderOf(src) : undefined;
const zoomSources =
  local && zoom && src.format !== "svg"
    ? (
        await Promise.all(
          [...new Set(ZOOM_WIDTHS.map((w) => Math.min(w, src.width)))].map(
            async (w) =>
              `${(await getImage({ src, width: w, format: "webp" })).src} ${w}w`
          )
        )
      ).join(", ")
    : undefined;
const frameStyle = stand ? `--ds-placeholder: url("${stand}")` : undefined;
// The original's size, so the zoom knows where it ends before anything larger loads.
const zoomWidth = local ? src.width : width;
const zoomHeight = local ? src.height : height;
const label = alt ? `Enlarge image: ${alt}` : "Enlarge image";
---

<ds-figure>
  <figure class:list={["ds-figure", className]}>
    {
      zoom ? (
        <button type="button" class="ds-figure__frame ds-figure__frame--zoom" style={frameStyle} aria-label={label}>
          {local ? (
            <Image
              src={src}
              alt={alt}
              widths={widths}
              sizes={sizes}
              loading={loading}
              class="ds-figure__img"
              data-ds-zoom={zoomSources}
              data-ds-zoom-width={zoomWidth}
              data-ds-zoom-height={zoomHeight}
            />
          ) : (
            <img
              src={src}
              alt={alt}
              width={width}
              height={height}
              loading={loading}
              class="ds-figure__img"
              data-ds-zoom-width={zoomWidth}
              data-ds-zoom-height={zoomHeight}
            />
          )}
        </button>
      ) : (
        <span class="ds-figure__frame" style={frameStyle}>
          {local ? (
            <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} class="ds-figure__img" />
          ) : (
            <img src={src} alt={alt} width={width} height={height} loading={loading} class="ds-figure__img" />
          )}
        </span>
      )
    }
    {caption && <figcaption class="ds-figure__caption">{caption}</figcaption>}
  </figure>
</ds-figure>

<script>
  import { parseDuration } from "../../scripts/fade";
  import {
    pickZoomSource,
    parseZoomSources,
    type Rect,
    shownImage,
    ZOOM_MARGIN,
    type ZoomFrame,
    zoomEnd,
    zoomedWidth,
    zoomStart,
    zoomTarget
  } from "./zoom";

  interface Open {
    img: HTMLImageElement;
    copy: HTMLImageElement;
    overlay: HTMLElement;
    target: Rect;
    scroll: number;
    closing: boolean;
    timer?: number;
  }

  /** The zoom open now; one for the page, so opening an image closes any other. */
  let open: Open | undefined;
  const larger = new WeakMap<HTMLImageElement, HTMLImageElement>();

  /** The original's size, which Figure writes; else the shape of what has loaded. */
  function naturalOf(img: HTMLImageElement) {
    const width = Number(img.dataset.dsZoomWidth) || img.naturalWidth || Number(img.getAttribute("width"));
    const height = Number(img.dataset.dsZoomHeight) || img.naturalHeight || Number(img.getAttribute("height"));
    return width && height ? { width, height } : undefined;
  }

  function viewport() {
    const root = document.documentElement;
    return { width: root.clientWidth, height: root.clientHeight };
  }

  function loadLarger(img: HTMLImageElement): HTMLImageElement | undefined {
    const known = larger.get(img);
    if (known) return known;
    const sources = parseZoomSources(img.dataset.dsZoom ?? "");
    const natural = naturalOf(img);
    if (!sources.length || !natural) return undefined;
    const source = pickZoomSource(sources, zoomedWidth(natural, viewport(), ZOOM_MARGIN, window.devicePixelRatio || 1));
    if (!source) return undefined;
    const copy = new Image();
    copy.decoding = "async";
    copy.src = source.src;
    larger.set(img, copy);
    return copy;
  }

  /** The open image laid over the image as the page shows it now, crop and corners included. */
  function startFrame(img: HTMLImageElement, target: Rect): ZoomFrame {
    const natural = naturalOf(img) ?? target;
    const box = img.getBoundingClientRect();
    const shown = shownImage(box, natural, getComputedStyle(img).objectFit);
    const frame = img.closest<HTMLElement>(".ds-figure__frame") ?? img;
    const radius = Number.parseFloat(getComputedStyle(frame).borderTopLeftRadius) || 0;
    return zoomStart(box, shown, target, radius);
  }

  function draw(copy: HTMLElement, frame: ZoomFrame) {
    copy.style.transform = frame.transform;
    copy.style.clipPath = frame.clip;
  }

  const onKey = (event: KeyboardEvent) => {
    if (event.key === "Escape") zoomOut();
  };
  const onScroll = () => {
    if (open && Math.abs(window.scrollY - open.scroll) > 40) zoomOut();
  };
  const onResize = () => zoomOut();
  function listen(on: boolean) {
    const method = on ? "addEventListener" : "removeEventListener";
    document[method]("keydown", onKey as EventListener);
    window[method]("scroll", onScroll);
    window[method]("resize", onResize);
  }

  async function zoomIn(img: HTMLImageElement) {
    finish();
    const natural = naturalOf(img);
    if (!natural) return;
    const shown = shownImage(img.getBoundingClientRect(), natural, getComputedStyle(img).objectFit);
    const target = zoomTarget(natural, viewport(), ZOOM_MARGIN, shown.width);
    const copy = document.createElement("img");
    copy.className = "ds-zoom-image";
    copy.alt = img.alt;
    copy.src = img.currentSrc || img.src;
    copy.style.left = `${target.left}px`;
    copy.style.top = `${target.top}px`;
    copy.style.width = `${target.width}px`;
    copy.style.height = `${target.height}px`;
    draw(copy, startFrame(img, target));
    const overlay = document.createElement("div");
    overlay.className = "ds-zoom-overlay";
    const state: Open = { img, copy, overlay, target, scroll: window.scrollY, closing: false };
    open = state;
    overlay.addEventListener("click", zoomOut);
    copy.addEventListener("click", zoomOut);
    // The page's own copy is already loaded; decoding it first keeps the first frame from being blank.
    await copy.decode().catch(() => undefined);
    if (open !== state) return;
    document.body.append(overlay, copy);
    img.dataset.dsZoomed = "";
    // The start frame is drawn before the end is set, so the change runs as a transition.
    copy.getBoundingClientRect();
    overlay.classList.add("ds-zoom--open");
    draw(copy, zoomEnd);
    listen(true);
    const sharper = loadLarger(img);
    sharper
      ?.decode()
      .then(() => {
        if (open === state) copy.src = sharper.src;
      })
      .catch(() => undefined);
  }

  /** Back to the image on the page, where it is now: the hidden sides close in as it shrinks. */
  function zoomOut() {
    const state = open;
    if (!state || state.closing) return;
    state.closing = true;
    listen(false);
    state.overlay.classList.remove("ds-zoom--open");
    draw(state.copy, startFrame(state.img, state.target));
    const time = parseDuration(getComputedStyle(state.copy).transitionDuration.split(",")[0] ?? "") ?? 0;
    if (time <= 0) return finish();
    state.copy.addEventListener("transitionend", (event) => {
      if (event.propertyName === "transform") finish();
    });
    state.timer = window.setTimeout(finish, time + 100);
  }

  /** Ends the zoom at once. */
  function finish() {
    const state = open;
    if (!state) return;
    open = undefined;
    clearTimeout(state.timer);
    listen(false);
    state.overlay.remove();
    state.copy.remove();
    delete state.img.dataset.dsZoomed;
  }

  class DsFigure extends HTMLElement {
    #img: HTMLImageElement | null = null;

    connectedCallback() {
      const button = this.querySelector<HTMLButtonElement>(".ds-figure__frame--zoom");
      this.#img = button?.querySelector("img") ?? null;
      if (!button || !this.#img) return;
      const img = this.#img;
      const warm = () => loadLarger(img);
      button.addEventListener("pointerenter", warm);
      button.addEventListener("focus", warm);
      button.addEventListener("touchstart", warm, { passive: true });
      // A click on the image and Enter or Space on the button both land here; while the zoom is
      // open, the overlay takes pointer clicks and the button only sees the keyboard.
      button.addEventListener("click", () => {
        if (open?.img === img && !open.closing) zoomOut();
        else void zoomIn(img);
      });
    }

    disconnectedCallback() {
      if (open?.img === this.#img) finish();
    }
  }

  if (!customElements.get("ds-figure")) customElements.define("ds-figure", DsFigure);
</script>

<style>
  ds-figure {
    display: block;
  }

  .ds-figure {
    margin: var(--space-lg) 0;
    max-width: var(--container-reading);
  }

  .ds-figure__frame {
    background: transparent;
    border: 0;
    border-radius: var(--radius-lg);
    display: block;
    overflow: hidden;
    padding: 0;
    position: relative;
    width: 100%;
  }

  .ds-figure__frame--zoom {
    cursor: zoom-in;
  }

  /* The 16px copy, stretched and blurred; scaled up a little so the blur has no pale edge. */
  .ds-figure__frame[style]::before {
    background: var(--ds-placeholder) center / cover no-repeat;
    content: "";
    filter: blur(12px);
    inset: 0;
    position: absolute;
    transform: scale(1.1);
  }

  .ds-figure__img {
    display: block;
    height: auto;
    position: relative;
    width: 100%;
  }

  .ds-figure__caption {
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: var(--body-sm-size);
    line-height: var(--body-sm-lh);
    margin-top: var(--space-xs);
  }

  /* The image on the page while its zoom is open. */
  .ds-figure__img[data-ds-zoomed] {
    visibility: hidden;
  }

  /* The zoom, above a sticky header: the image is set at its open size and drawn from the page's. */
  :global(.ds-zoom-overlay) {
    background: rgb(20 20 19 / 72%);
    cursor: zoom-out;
    inset: 0;
    opacity: 0;
    position: fixed;
    transition: opacity var(--motion-entrance) var(--ease-move);
    z-index: 100;
  }

  :global(.ds-zoom-overlay.ds-zoom--open) {
    opacity: 1;
  }

  :global(.ds-zoom-image) {
    cursor: zoom-out;
    display: block;
    max-width: none;
    object-fit: fill;
    position: fixed;
    transform-origin: 0 0;
    transition:
      transform var(--motion-entrance) var(--ease-move),
      clip-path var(--motion-entrance) var(--ease-move);
    will-change: transform, clip-path;
    z-index: 100;
  }
</style>
