---
import { getImage, Image } from "astro:assets";
/**
 * One image in a post with an optional caption; it opens larger with medium-zoom. A blurred 16px
 * copy shows while a local image loads. The zoom opens from the image on the page, and the
 * smallest larger copy that covers the screen replaces it once loaded; loading starts on hover or
 * focus.
 */
import type { ImageMetadata } from "astro";
import { placeholderOf } from "./placeholder";

interface Props {
  /** An imported image, which gets the placeholder and a larger copy to zoom into, or a URL. */
  src: ImageMetadata | string;
  /** Describes the image. Empty only for a decorative image. */
  alt: string;
  /** One line under the image. */
  caption?: string;
  /** Opens the image larger on click. */
  zoom?: boolean;
  /** Shows the blurred copy while a local, opaque image loads. */
  placeholder?: boolean;
  /** Needed for a URL; an imported image knows its size. */
  width?: number;
  height?: number;
  /** Passed to Astro's <Image> for an imported image. */
  widths?: number[];
  sizes?: string;
  loading?: "lazy" | "eager";
  class?: string;
}

const ZOOM_WIDTHS = [1200, 1800, 2400];

const {
  src,
  alt,
  caption,
  zoom = true,
  placeholder = true,
  width,
  height,
  widths,
  sizes,
  loading = "lazy",
  class: className
} = Astro.props;

const local = typeof src !== "string";
const stand = local && placeholder ? await placeholderOf(src) : undefined;
const zoomSources =
  local && zoom && src.format !== "svg"
    ? (
        await Promise.all(
          [...new Set(ZOOM_WIDTHS.map((w) => Math.min(w, src.width)))].map(
            async (w) =>
              `${(await getImage({ src, width: w, format: "webp" })).src} ${w}w`
          )
        )
      ).join(", ")
    : undefined;
const frameStyle = stand ? `--ds-placeholder: url("${stand}")` : undefined;
const label = alt ? `Enlarge image: ${alt}` : "Enlarge image";
---

<ds-figure>
  <figure class:list={["ds-figure", className]}>
    {
      zoom ? (
        <button type="button" class="ds-figure__frame ds-figure__frame--zoom" style={frameStyle} aria-label={label}>
          {local ? (
            <Image
              src={src}
              alt={alt}
              widths={widths}
              sizes={sizes}
              loading={loading}
              class="ds-figure__img"
              data-ds-zoom={zoomSources}
            />
          ) : (
            <img src={src} alt={alt} width={width} height={height} loading={loading} class="ds-figure__img" />
          )}
        </button>
      ) : (
        <span class="ds-figure__frame" style={frameStyle}>
          {local ? (
            <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} class="ds-figure__img" />
          ) : (
            <img src={src} alt={alt} width={width} height={height} loading={loading} class="ds-figure__img" />
          )}
        </span>
      )
    }
    {caption && <figcaption class="ds-figure__caption">{caption}</figcaption>}
  </figure>
</ds-figure>

<script>
  import mediumZoom from "medium-zoom";
  import { parseZoomSources, pickZoomSource, ZOOM_MARGIN, zoomedWidth } from "./zoom";

  // One zoom for the page, so opening one image closes any other.
  const zoom = mediumZoom({ background: "rgba(20, 20, 19, 0.72)", margin: ZOOM_MARGIN });

  const larger = new WeakMap<HTMLImageElement, HTMLImageElement>();

  function loadLarger(img: HTMLImageElement): HTMLImageElement | undefined {
    const known = larger.get(img);
    if (known) return known;
    const sources = parseZoomSources(img.dataset.dsZoom ?? "");
    // Only the shape matters; before the image loads, its width and height attributes give it.
    const width = img.naturalWidth || Number(img.getAttribute("width"));
    const height = img.naturalHeight || Number(img.getAttribute("height"));
    if (!sources.length || !width || !height) return undefined;
    const needed = zoomedWidth(
      { width, height },
      { width: window.innerWidth, height: window.innerHeight },
      ZOOM_MARGIN,
      window.devicePixelRatio || 1
    );
    const source = pickZoomSource(sources, needed);
    if (!source) return undefined;
    const copy = new Image();
    copy.decoding = "async";
    copy.src = source.src;
    larger.set(img, copy);
    return copy;
  }

  // The open copy is the one medium-zoom adds to <body> right after its open event.
  function swapIn(img: HTMLImageElement) {
    const copy = loadLarger(img);
    if (!copy) return;
    copy
      .decode()
      .then(() => {
        // The open copy keeps the image's attributes, so another image opened since is told apart.
        const open = document.querySelector<HTMLImageElement>("img.medium-zoom-image--opened");
        if (!open || open.dataset.dsZoom !== img.dataset.dsZoom) return;
        open.removeAttribute("srcset");
        open.removeAttribute("sizes");
        open.src = copy.src;
      })
      .catch(() => undefined);
  }

  class DsFigure extends HTMLElement {
    #img: HTMLImageElement | null = null;

    connectedCallback() {
      const button = this.querySelector<HTMLButtonElement>(".ds-figure__frame--zoom");
      this.#img = button?.querySelector("img") ?? null;
      if (!button || !this.#img) return;
      const img = this.#img;
      zoom.attach(img);
      const warm = () => loadLarger(img);
      button.addEventListener("pointerenter", warm);
      button.addEventListener("focus", warm);
      button.addEventListener("touchstart", warm, { passive: true });
      // medium-zoom's events do not bubble, so each image listens for its own.
      img.addEventListener("medium-zoom:open", () => swapIn(img));
      button.addEventListener("click", (event) => {
        // A pointer lands on the image, which medium-zoom handles from the document. Enter and
        // Space land on the button itself; stopping there keeps medium-zoom from reading the
        // click as one outside the image, which would close it again.
        if (event.target !== button) return;
        event.stopPropagation();
        zoom.open({ target: img });
      });
    }

    disconnectedCallback() {
      if (this.#img) zoom.detach(this.#img);
    }
  }

  if (!customElements.get("ds-figure")) customElements.define("ds-figure", DsFigure);
</script>

<style>
  ds-figure {
    display: block;
  }

  .ds-figure {
    margin: var(--space-lg) 0;
    max-width: var(--container-reading);
  }

  .ds-figure__frame {
    background: transparent;
    border: 0;
    border-radius: var(--radius-lg);
    display: block;
    overflow: hidden;
    padding: 0;
    position: relative;
    width: 100%;
  }

  .ds-figure__frame--zoom {
    cursor: zoom-in;
  }

  /* The 16px copy, stretched and blurred; scaled up a little so the blur has no pale edge. */
  .ds-figure__frame[style]::before {
    background: var(--ds-placeholder) center / cover no-repeat;
    content: "";
    filter: blur(12px);
    inset: 0;
    position: absolute;
    transform: scale(1.1);
  }

  .ds-figure__img {
    display: block;
    height: auto;
    position: relative;
    width: 100%;
  }

  .ds-figure__caption {
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: var(--body-sm-size);
    line-height: var(--body-sm-lh);
    margin-top: var(--space-xs);
  }

  /* medium-zoom's copy would keep a tile's crop; it shows the whole image, above a sticky header. */
  :global(.ds-figure__img.medium-zoom-image--opened) {
    object-fit: contain;
  }

  :global(.medium-zoom-overlay),
  :global(.medium-zoom-image--opened) {
    z-index: 100;
  }
</style>
