---
/**
 * A code block: pass `code` and `lang` to highlight with Shiki, or put Shiki's <pre> in the slot.
 * Long lines scroll rather than wrap, and a block over 12 lines starts folded to 10. Show all sits
 * inside the scroll area, pinned to its left edge, so the horizontal scrollbar is the block's last row.
 *
 * It imports Shiki's theme objects instead of naming them: a bundler that inlines Shiki empties
 * its table of named themes.
 */
import githubDark from "@shikijs/themes/github-dark";
import githubLight from "@shikijs/themes/github-light";
import { bundledLanguages, codeToHtml } from "shiki";
import Check from "../../icons/check.svg";
import Copy from "../../icons/copy.svg";
import { shikiTransformers } from "../../markdown/shiki.js";

interface Props {
  /** The source as a plain string. */
  code?: string;
  /** Shown left in the bar, in the mono face: "tokens/motion.css". */
  filename?: string;
  /** Shown without a filename; defaults to "Terminal" or "Code Block", false for none. */
  label?: string | false;
  /** Uppercase language label right of the filename, and Shiki's language for `code`. */
  lang?: string;
  showLineNumbers?: boolean;
  /** 1-based line numbers to wash and mark with a coral gutter rule. */
  highlightLines?: number[];
  /** Renders the copy button. */
  copy?: boolean;
  /** Caption under the block. */
  caption?: string;
  /** `auto` follows the theme, `dark` is navy in both, `cream` darkens in the dark theme. */
  tone?: "auto" | "dark" | "cream";
  /** false drops the frame (margin, border, radius, fill). */
  frame?: boolean;
  class?: string;
}

const {
  code,
  filename,
  label,
  lang,
  showLineNumbers = true,
  highlightLines = [],
  copy = true,
  caption,
  tone = "auto",
  frame = true,
  class: className,
  ...rest
} = Astro.props;

const meta = highlightLines.length ? `{${highlightLines.join(",")}}` : "";
const html =
  code === undefined
    ? undefined
    : await codeToHtml(code.replace(/\n$/, ""), {
        lang: lang && lang in bundledLanguages ? lang : "text",
        themes: { light: githubLight, dark: githubDark },
        defaultColor: false,
        transformers: shikiTransformers(),
        meta: { __raw: meta }
      });
const hasBar = Boolean(filename || lang || copy);
const SHELLS = new Set([
  "bash",
  "bat",
  "batch",
  "cmd",
  "console",
  "fish",
  "nu",
  "nushell",
  "powershell",
  "ps",
  "ps1",
  "pwsh",
  "sh",
  "shell",
  "shellscript",
  "shellsession",
  "zsh"
]);
const name =
  filename ??
  (label === false
    ? undefined
    : (label ??
      (lang && SHELLS.has(lang.toLowerCase()) ? "Terminal" : "Code Block")));
---

<ds-code-block data-copy={copy ? "" : undefined}>
  <figure
    class:list={[
      "ds-code",
      `ds-code--${tone}`,
      {
        "ds-code--framed": frame,
        "ds-code--numbered": showLineNumbers
      },
      className
    ]}
    {...rest}
  >
    {
      hasBar && (
        <div class="ds-code__bar">
          <span class:list={["ds-code__filename", { "ds-code__filename--generic": !filename }]}>{name}</span>
          {lang && <span class="ds-code__lang">{lang}</span>}
          {copy && (
            <button type="button" class="ds-code__copy" aria-label="Copy code" data-ds-tap="cell">
              <Copy class="ds-code__icon ds-code__icon--copy" width={16} height={16} aria-hidden="true" />
              <Check class="ds-code__icon ds-code__icon--done" width={16} height={16} aria-hidden="true" />
              <span class="ds-code__copied">Copied</span>
            </button>
          )}
        </div>
      )
    }
    <div class="ds-code__scroll">
      {
        html !== undefined ? (
          <Fragment set:html={html} />
        ) : (
          <slot />
        )
      }
      <button type="button" class="ds-code__expand" hidden>Show all lines</button>
    </div>
    {caption && <figcaption class="ds-code__caption">{caption}</figcaption>}
  </figure>
</ds-code-block>

<script>
  /** Lines shown while folded, and the length a block must exceed to fold. */
  const FOLDED_LINES = 10;
  const FOLD_AFTER = 12;

  class DsCodeBlock extends HTMLElement {
    connectedCallback() {
      const pre = this.querySelector("pre");
      if (!pre) return;
      const lines = pre.querySelectorAll(".line").length;

      const button = this.querySelector<HTMLButtonElement>(".ds-code__copy");
      if (button) {
        // Copies the code after the change: removed lines and trailing [!code] spaces left out.
        const text = () =>
          [...pre.querySelectorAll(".line")]
            .filter((line) => !line.classList.contains("remove"))
            .map((line) => (line.textContent ?? "").replace(/\s+$/, ""))
            .join("\n");
        let timer: ReturnType<typeof setTimeout> | undefined;
        button.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(text());
          } catch {
            return;
          }
          button.dataset.copied = "";
          button.setAttribute("aria-label", "Copied");
          clearTimeout(timer);
          timer = setTimeout(() => {
            delete button.dataset.copied;
            button.setAttribute("aria-label", "Copy code");
          }, 1600);
        });
      }

      const expand = this.querySelector<HTMLButtonElement>(".ds-code__expand");
      if (expand && lines > FOLD_AFTER) {
        const figure = this.querySelector("figure");
        figure?.style.setProperty("--ds-code-folded-lines", String(FOLDED_LINES));
        figure?.classList.add("ds-code--folded");
        expand.hidden = false;
        expand.textContent = `Show all ${lines} lines`;
        expand.setAttribute("aria-expanded", "false");
        expand.addEventListener("click", () => {
          figure?.classList.remove("ds-code--folded");
          expand.hidden = true;
          expand.setAttribute("aria-expanded", "true");
        });
      }
    }
  }

  if (!customElements.get("ds-code-block")) customElements.define("ds-code-block", DsCodeBlock);
</script>

<style>
  ds-code-block {
    display: block;
  }

  .ds-code {
    --ds-code-ink: var(--text-on-dark);
    --ds-code-soft: var(--text-on-dark-soft);
    --ds-code-rule: var(--hairline-on-dark);
    --ds-code-wash: rgba(250, 249, 245, 0.06);
    --ds-code-bar: var(--surface-dark-soft);
    --ds-code-fill: var(--surface-dark);
    box-sizing: border-box;
    /* Shiki's tokens pick their dark colour by this, and the scrollbar is dark. */
    --theme-dark: 100%;
    color-scheme: dark;
    margin: 0;
    max-width: 100%;
  }

  .ds-code--cream {
    --ds-code-ink: var(--text-body-strong);
    --ds-code-soft: var(--text-muted);
    --ds-code-rule: var(--hairline);
    --ds-code-wash: var(--surface-soft);
    --ds-code-bar: var(--surface-card);
    --ds-code-fill: var(--surface-canvas);
    --theme-dark: inherit;
    color-scheme: inherit;
  }

  /* Own theme tokens, not a --theme-dark mix of two fading tones, which would run ahead of the page. */
  .ds-code--auto {
    --ds-code-ink: var(--text-body-strong);
    --ds-code-soft: var(--text-muted);
    --ds-code-rule: var(--hairline-code);
    --ds-code-wash: var(--surface-code-highlight);
    --ds-code-bar: var(--surface-code-bar);
    --ds-code-fill: var(--surface-code);
    --theme-dark: inherit;
    color-scheme: inherit;
  }

  .ds-code--framed {
    background: var(--ds-code-fill);
    border: 1px solid transparent;
    border-radius: var(--radius-lg);
    margin: var(--space-lg) 0;
    overflow: hidden;
  }

  .ds-code--framed.ds-code--cream {
    border-color: var(--hairline);
  }

  .ds-code--framed.ds-code--auto {
    border-color: var(--hairline-code-frame);
  }

  .ds-code__bar {
    align-items: center;
    background: var(--ds-code-bar);
    border-bottom: 1px solid var(--ds-code-rule);
    color: var(--ds-code-soft);
    display: flex;
    font-family: var(--font-mono);
    font-size: var(--caption-size);
    gap: var(--space-sm);
    padding: var(--space-xs) var(--space-sm) var(--space-xs) var(--space-md);
  }

  .ds-code__filename {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ds-code__lang {
    flex: 0 0 auto;
    font-family: var(--font-sans);
    font-size: var(--caption-upper-size);
    font-weight: var(--caption-upper-weight);
    letter-spacing: var(--caption-upper-ls);
    line-height: var(--caption-upper-lh);
    text-transform: uppercase;
  }

  .ds-code__copy {
    align-items: center;
    background: transparent;
    border: 0;
    border-radius: var(--radius-sm);
    color: var(--ds-code-soft);
    cursor: pointer;
    display: inline-flex;
    flex: 0 0 auto;
    font-family: var(--font-sans);
    font-size: var(--caption-size);
    gap: var(--space-xxs);
    height: 24px;
    padding: 0 var(--space-xs);
    transition: var(--transition-tint);
  }

  .ds-code__copy:hover {
    color: var(--ds-code-ink);
  }

  .ds-code__copy[data-copied] {
    color: var(--color-primary);
  }

  .ds-code__icon--done,
  .ds-code__copied,
  .ds-code__copy[data-copied] .ds-code__icon--copy {
    display: none;
  }

  .ds-code__copy[data-copied] .ds-code__icon--done,
  .ds-code__copy[data-copied] .ds-code__copied {
    display: inline;
  }

  .ds-code__scroll {
    overflow-x: auto;
    scrollbar-color: var(--ds-code-soft) transparent;
    padding-top: var(--space-md);
  }

  .ds-code__scroll :global(pre) {
    background: transparent !important;
    color: color-mix(in srgb, var(--shiki-light), var(--shiki-dark) var(--theme-dark));
    font-family: var(--font-mono);
    font-size: var(--code-size);
    line-height: var(--code-lh);
    margin: 0;
    /* Astro writes overflow-x: auto on a post's <pre>; the scroll area scrolls instead. */
    overflow: visible !important;
    padding: 0 0 var(--space-md);
  }

  .ds-code__scroll :global(pre span) {
    color: color-mix(in srgb, var(--shiki-light), var(--shiki-dark) var(--theme-dark));
  }

  .ds-code__scroll :global(code) {
    counter-reset: ds-code-line;
    display: block;
    min-width: max-content;
  }

  .ds-code__scroll :global(.line) {
    box-sizing: border-box;
    display: inline-block;
    min-width: 100%;
    padding: 0 var(--space-md);
  }

  .ds-code--numbered .ds-code__scroll :global(pre:not([data-line-numbers="false"]) code:has(.line + .line) .line::before) {
    color: var(--ds-code-soft);
    content: counter(ds-code-line);
    counter-increment: ds-code-line;
    display: inline-block;
    font-variant-numeric: tabular-nums;
    margin-right: var(--space-md);
    min-width: 2ch;
    text-align: right;
    user-select: none;
  }

  .ds-code__scroll :global(.line.highlighted) {
    background: var(--ds-code-wash);
    box-shadow: inset 2px 0 0 var(--color-primary);
  }

  .ds-code__scroll :global(.line.diff.add) {
    background: color-mix(in oklab, var(--status-success) 14%, transparent);
    box-shadow: inset 2px 0 0 var(--status-success);
  }

  .ds-code__scroll :global(.line.diff.remove) {
    background: color-mix(in oklab, var(--status-error) 14%, transparent);
    box-shadow: inset 2px 0 0 var(--status-error);
    opacity: 0.8;
  }

  .ds-code__scroll :global(.line.highlighted.error) {
    background: color-mix(in oklab, var(--status-error) 14%, transparent);
    box-shadow: inset 2px 0 0 var(--status-error);
  }

  .ds-code__scroll :global(.line.highlighted.warning) {
    background: color-mix(in oklab, var(--status-warning) 14%, transparent);
    box-shadow: inset 2px 0 0 var(--status-warning);
  }

  .ds-code__scroll :global(pre.has-focused .line:not(.focused)) {
    filter: blur(0.5px);
    opacity: 0.45;
    transition: var(--transition-fade);
  }

  .ds-code__scroll:hover :global(pre.has-focused .line:not(.focused)) {
    filter: none;
    opacity: 1;
  }

  /*
   * Folded on the <pre>, not the scroll area, so Show all and the scrollbar stay out of the fade.
   * The <pre> is as wide as its longest line, since the mask clips to its box.
   */
  .ds-code--folded .ds-code__scroll :global(pre) {
    box-sizing: border-box;
    mask-image: linear-gradient(to bottom, #000 70%, transparent);
    max-height: calc(var(--ds-code-folded-lines) * var(--code-lh) * var(--code-size) + var(--space-md));
    min-width: 100%;
    overflow-x: visible !important;
    overflow-y: clip !important;
    width: max-content;
  }

  .ds-code__expand {
    background: transparent;
    border: 0;
    border-top: 1px solid var(--ds-code-rule);
    color: var(--ds-code-soft);
    cursor: pointer;
    display: block;
    font-family: var(--font-sans);
    font-size: var(--caption-size);
    /* In the scroll area, as wide as what shows of it and held at its left edge. */
    left: 0;
    padding: var(--space-xs) var(--space-md);
    position: sticky;
    text-align: left;
    transition: var(--transition-tint);
    width: 100%;
  }

  .ds-code__expand[hidden] {
    display: none;
  }

  .ds-code__expand:hover {
    color: var(--ds-code-ink);
  }

  .ds-code__caption {
    color: var(--ds-code-soft);
    font-family: var(--font-sans);
    font-size: var(--caption-size);
    padding: var(--space-xs) var(--space-md) var(--space-sm);
  }
</style>
