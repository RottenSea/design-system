---
/**
 * Sets data-theme on <html> before the first paint: the theme the reader picked with
 * ThemeToggle, or else the OS setting. Without it the light theme shows for a moment before a
 * dark reader's page turns dark. Put it in the <head>, before the stylesheets.
 *
 * The handoff gives this as a snippet to paste, because a React component mounts after the first
 * paint; an Astro component can write the script into the HTML as it is, so it is a component.
 */
interface Props {
  /** The localStorage key ThemeToggle writes. */
  storageKey?: string;
}

const { storageKey = "ds-theme" } = Astro.props;
---

<script is:inline define:vars={{ key: storageKey }}>
  let theme;
  try {
    theme = localStorage.getItem(key);
  } catch {}
  if (theme !== "light" && theme !== "dark") theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
  document.documentElement.dataset.theme = theme;
</script>
