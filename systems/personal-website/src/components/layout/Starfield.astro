---
/**
 * Drifting, twinkling stars on a canvas behind the page. --ds-sky-star sets the colour,
 * --ds-sky-star-strength the opacity factor and --ds-sky-star-grow a length added to each radius:
 * a dark dot on a light ground looks smaller, so the light theme grows them.
 */

interface Props {
  /** Seconds a star at full depth takes to cross the longer side. */
  period?: number;
  /** One star per this many square pixels. */
  area?: number;
  /** "fixed" (default) covers the window; "absolute" fills the nearest positioned ancestor. */
  position?: "fixed" | "absolute";
  class?: string;
}

const {
  period = 140,
  area = 5000,
  position = "fixed",
  class: className
} = Astro.props;
---

<ds-starfield
  class:list={["ds-sky", `ds-sky--${position}`, className]}
  data-period={period}
  data-area={area}
  aria-hidden="true"
>
  <canvas></canvas>
</ds-starfield>

<script>
  import { drawStars, makeStars, runSky, type Star } from "./sky";

  class DsStarfield extends HTMLElement {
    #stop: (() => void) | undefined;

    connectedCallback() {
      const canvas = this.querySelector("canvas");
      if (!canvas) return;
      const period = Number(this.dataset.period) || 140;
      const area = Number(this.dataset.area) || 5000;
      let stars: Star[] = [];
      this.#stop = runSky(this, canvas, {
        colors: ["--ds-sky-star"],
        numbers: ["--ds-sky-star-strength", "--ds-sky-star-grow"],
        resize: (width, height) => {
          stars = makeStars(width, height, area);
        },
        draw: (ctx, t, [star], width, height, [strength, grow]) => {
          drawStars(ctx, stars, t, { width, height, period }, star, strength, undefined, grow);
        }
      });
    }

    disconnectedCallback() {
      this.#stop?.();
    }
  }

  if (!customElements.get("ds-starfield")) customElements.define("ds-starfield", DsStarfield);
</script>

<style>
  ds-starfield {
    --ds-sky-star: var(--accent-teal);
    --ds-sky-star-strength: 1.6;
    --ds-sky-star-grow: 0.3px;
    display: block;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  :global([data-theme="dark"]) ds-starfield {
    --ds-sky-star-strength: 1;
    --ds-sky-star-grow: 0px;
  }

  /* A page that gives <html> a background would paint <body>'s over the sky. */
  .ds-sky--fixed {
    position: fixed;
    z-index: -1;
  }

  .ds-sky--absolute {
    position: absolute;
  }

  canvas {
    display: block;
    height: 100%;
    width: 100%;
  }
</style>
