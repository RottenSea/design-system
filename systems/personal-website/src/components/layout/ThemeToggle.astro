---
/**
 * A button that switches between the light and dark theme through the theme store. Both icons are
 * in the HTML and CSS shows the current one, so it is right from the first paint.
 */
import IconButton from "../buttons/IconButton.astro";

interface Props {
  /** The localStorage key; ThemeScript must use the same one, and its key wins. */
  storageKey?: string;
  tone?: "canvas" | "dark";
  labels?: { light: string; dark: string };
  class?: string;
}

const {
  storageKey = "ds-theme",
  tone = "canvas",
  labels = { light: "Switch to light theme", dark: "Switch to dark theme" },
  class: className
} = Astro.props;
---

<ds-theme-toggle class:list={["ds-theme-toggle", className]} data-storage-key={storageKey}>
  <IconButton icon="moon" label={labels.dark} tone={tone} class="ds-theme-toggle__to-dark" data-theme-to="dark" />
  <IconButton icon="sun" label={labels.light} tone={tone} class="ds-theme-toggle__to-light" data-theme-to="light" />
</ds-theme-toggle>

<script>
  import { themeStore } from "../../scripts/theme";

  class DsThemeToggle extends HTMLElement {
    connectedCallback() {
      const store = themeStore(this.dataset.storageKey);
      for (const button of this.querySelectorAll<HTMLButtonElement>("[data-theme-to]")) {
        button.addEventListener("click", () => {
          const theme = button.dataset.themeTo === "dark" ? "dark" : "light";
          store.set(theme);
          // The other button takes this one's place; keep the keyboard focus on it.
          this.querySelector<HTMLButtonElement>(`[data-theme-to="${theme === "dark" ? "light" : "dark"}"]`)?.focus();
        });
      }
    }
  }

  if (!customElements.get("ds-theme-toggle")) customElements.define("ds-theme-toggle", DsThemeToggle);
</script>

<style>
  .ds-theme-toggle {
    display: inline-flex;
  }

  /* In the dark theme the button offers light, and the other way round. */
  :global([data-theme="dark"]) .ds-theme-toggle > :global(.ds-theme-toggle__to-dark),
  :global([data-theme="light"]) .ds-theme-toggle > :global(.ds-theme-toggle__to-light),
  :global(:root:not([data-theme])) .ds-theme-toggle > :global(.ds-theme-toggle__to-light) {
    display: none;
  }
</style>
