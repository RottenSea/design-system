---
/**
 * The dark footer: a brand column with the `brand-extra` slot, link columns, and a note line.
 * Placed straight in <body>, it sits on the window's bottom edge on a short page.
 */
import type { MenuLink } from "./MenuPanel.astro";

export interface FooterColumn {
  title: string;
  links: MenuLink[];
}

interface Props {
  brand: string;
  columns?: FooterColumn[];
  /** The bottom line. A `note` slot takes its place. */
  note?: string;
  class?: string;
}

const { brand, columns = [], note, class: className } = Astro.props;
const external = (href: string) =>
  /^(?:[a-z]+:|\/\/)/i.test(href) && !href.startsWith("mailto:");
const hasNote = note !== undefined || Astro.slots.has("note");
const hasExtra = Astro.slots.has("brand-extra");
---

<footer class:list={["ds-footer", className]}>
  <div class="ds-footer__inner">
    <div class="ds-footer__lead">
      <div class="ds-footer__brand">
        <slot name="logo" />
        <span class="ds-footer__brand-name">{brand}</span>
      </div>
      {
        hasExtra && (
          <div class="ds-footer__extra">
            <slot name="brand-extra" />
          </div>
        )
      }
    </div>
    {
      columns.length > 0 && (
        <div class="ds-footer__grid">
          {columns.map((column) => (
            <nav class="ds-footer__column" aria-label={column.title}>
              <span class="ds-footer__title">{column.title}</span>
              {column.links.map((link) =>
                external(link.href) ? (
                  <a class="ds-footer__link" href={link.href} target="_blank" rel="noreferrer">
                    {link.label}
                    <span aria-hidden="true">↗</span>
                    <span class="ds-visually-hidden"> (opens in a new tab)</span>
                  </a>
                ) : (
                  <a class="ds-footer__link" href={link.href}>
                    {link.label}
                  </a>
                )
              )}
            </nav>
          ))}
        </div>
      )
    }
    {
      hasNote && (
        <p class="ds-footer__note">
          <slot name="note">{note}</slot>
        </p>
      )
    }
  </div>
</footer>

<style>
  .ds-footer {
    background: var(--surface-dark);
    color: var(--text-on-dark-soft);
    margin-top: auto;
    padding: 64px var(--space-lg);
  }

  /* A child with auto side margins shrinks to its content in this column, so it must set a width. */
  :global(body:has(> .ds-footer)) {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }

  .ds-footer__inner {
    align-items: start;
    column-gap: calc(var(--space-xxl) * 2);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    row-gap: var(--space-xxl);
    margin: 0 auto;
    max-width: var(--container-max);
  }

  /* As tall as the link columns beside it: the brand at the top, brand-extra at the bottom. */
  .ds-footer__lead {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .ds-footer__brand {
    align-items: center;
    display: flex;
    gap: var(--space-xs);
  }

  .ds-footer__extra {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: auto;
  }

  .ds-footer__extra > :global(img),
  .ds-footer__extra > :global(svg) {
    display: block;
    height: auto;
    max-width: 100%;
  }

  .ds-footer__brand-name {
    color: var(--text-on-dark);
    font-family: var(--font-sans);
    font-size: var(--title-sm-size);
    font-weight: 500;
  }

  .ds-footer__grid {
    display: grid;
    gap: calc(var(--space-xxl) * 1.5);
    grid-auto-columns: max-content;
    grid-auto-flow: column;
    justify-content: start;
  }

  .ds-footer__column {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .ds-footer__title {
    color: var(--text-on-dark);
    font-family: var(--font-sans);
    font-size: var(--caption-upper-size);
    font-weight: var(--caption-upper-weight);
    letter-spacing: var(--caption-upper-ls);
    line-height: var(--caption-upper-lh);
    text-transform: uppercase;
  }

  .ds-footer__link {
    align-self: flex-start;
    color: var(--text-on-dark-soft);
    font-family: var(--font-sans);
    font-size: var(--body-sm-size);
    line-height: var(--body-sm-lh);
    text-decoration: none;
    transition: var(--transition-tint);
  }

  .ds-footer__link:hover {
    color: var(--text-on-dark);
  }

  .ds-footer__note {
    border-top: 1px solid var(--hairline-on-dark);
    grid-column: 1 / -1;
    color: var(--text-on-dark-soft);
    font-family: var(--font-sans);
    font-size: var(--body-sm-size);
    line-height: var(--body-sm-lh);
    margin: 0;
    padding-top: var(--space-lg);
  }

  .ds-footer__note :global(a) {
    color: var(--text-on-dark);
  }

  @media (max-width: 768px) {
    .ds-footer__inner {
      gap: var(--space-xxl);
      grid-template-columns: minmax(0, 1fr);
    }

    .ds-footer__grid {
      gap: var(--space-xl);
      grid-auto-flow: row;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
