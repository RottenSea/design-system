---
/**
 * The dark footer that closes every page, in both themes: a column with the site's mark and name
 * at the top and whatever the `brand-extra` slot holds (a badge, a short line) at the bottom, then
 * a column for each list of links under its uppercase micro-label, all from the left. The link
 * columns are as wide as their links and close together; a wider space parts them from the brand,
 * which leads. A line across the bottom holds the copyright. The link columns set the height, and
 * brand-extra sits level with the end of the longest.
 * --surface-dark, 64px of padding above and below, within --container-max. Below 768px the brand
 * column stacks above the links, which go two across. A
 * link to another site opens in a new tab with the arrow and the hidden note the system's other
 * links to other sites have. Placed straight in <body>, it sits on the window's bottom edge on a
 * page shorter than the window: <body> becomes a column at least as tall as the window, and the
 * footer takes the space left over above it.
 *
 * Ported from the handoff's Footer.jsx with the same props, with links as { label, href } and
 * `onNavigate` left out. The handoff puts the name above four columns of links; this system gives
 * the brand a column of its own beside them (2026-11-03). `note` can also be a slot, for a line
 * with links in it. The
 * note is --text-on-dark-soft rather than the handoff's --text-muted-soft, which is 3.5:1 on the
 * footer in the dark theme.
 *
 *   <Footer brand="The Key of Urala" columns={[{ title: "Site", links: [{ label: "Blog", href: "/" }] }]}
 *     note="© 2026 …">
 *     <Logo slot="logo" width={24} height={24} aria-hidden="true" />
 *     <img slot="brand-extra" src="/badge.svg" alt="…" width="131" height="42" />
 *   </Footer>
 */
import type { MenuLink } from "./MenuPanel.astro";

export interface FooterColumn {
  title: string;
  links: MenuLink[];
}

interface Props {
  brand: string;
  columns?: FooterColumn[];
  /** The bottom line. A `note` slot takes its place. */
  note?: string;
  class?: string;
}

const { brand, columns = [], note, class: className } = Astro.props;
const external = (href: string) =>
  /^(?:[a-z]+:|\/\/)/i.test(href) && !href.startsWith("mailto:");
const hasNote = note !== undefined || Astro.slots.has("note");
const hasExtra = Astro.slots.has("brand-extra");
---

<footer class:list={["ds-footer", className]}>
  <div class="ds-footer__inner">
    <div class="ds-footer__lead">
      <div class="ds-footer__brand">
        <slot name="logo" />
        <span class="ds-footer__brand-name">{brand}</span>
      </div>
      {
        hasExtra && (
          <div class="ds-footer__extra">
            <slot name="brand-extra" />
          </div>
        )
      }
    </div>
    {
      columns.length > 0 && (
        <div class="ds-footer__grid">
          {columns.map((column) => (
            <nav class="ds-footer__column" aria-label={column.title}>
              <span class="ds-footer__title">{column.title}</span>
              {column.links.map((link) =>
                external(link.href) ? (
                  <a class="ds-footer__link" href={link.href} target="_blank" rel="noreferrer">
                    {link.label}
                    <span aria-hidden="true">↗</span>
                    <span class="ds-visually-hidden"> (opens in a new tab)</span>
                  </a>
                ) : (
                  <a class="ds-footer__link" href={link.href}>
                    {link.label}
                  </a>
                )
              )}
            </nav>
          ))}
        </div>
      )
    }
    {
      hasNote && (
        <p class="ds-footer__note">
          <slot name="note">{note}</slot>
        </p>
      )
    }
  </div>
</footer>

<style>
  .ds-footer {
    background: var(--surface-dark);
    color: var(--text-on-dark-soft);
    margin-top: auto;
    padding: 64px var(--space-lg);
  }

  /* <body>, when the footer is in it: at least as tall as the window, so the footer's auto top
     margin takes up a short page's spare height. dvh follows a phone's address bar as it shows
     and hides. A child with auto side margins would shrink to its content in a column, so such a
     child sets its width as well. */
  :global(body:has(> .ds-footer)) {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }

  /* The brand column, then the link columns, from the left; the note across the bottom. The space
     after the brand, 96px, is a third wider than the 72px between the link columns. */
  .ds-footer__inner {
    align-items: start;
    column-gap: calc(var(--space-xxl) * 2);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    row-gap: var(--space-xxl);
    margin: 0 auto;
    max-width: var(--container-max);
  }

  /* As tall as the link columns beside it: the brand at the top, brand-extra at the bottom. */
  .ds-footer__lead {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .ds-footer__brand {
    align-items: center;
    display: flex;
    gap: var(--space-xs);
  }

  .ds-footer__extra {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: auto;
  }

  .ds-footer__extra > :global(img),
  .ds-footer__extra > :global(svg) {
    display: block;
    height: auto;
    max-width: 100%;
  }

  .ds-footer__brand-name {
    color: var(--text-on-dark);
    font-family: var(--font-sans);
    font-size: var(--title-sm-size);
    font-weight: 500;
  }

  .ds-footer__grid {
    display: grid;
    gap: calc(var(--space-xxl) * 1.5);
    grid-auto-columns: max-content;
    grid-auto-flow: column;
    justify-content: start;
  }

  .ds-footer__column {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .ds-footer__title {
    color: var(--text-on-dark);
    font-family: var(--font-sans);
    font-size: var(--caption-upper-size);
    font-weight: var(--caption-upper-weight);
    letter-spacing: var(--caption-upper-ls);
    line-height: var(--caption-upper-lh);
    text-transform: uppercase;
  }

  .ds-footer__link {
    align-self: flex-start;
    color: var(--text-on-dark-soft);
    font-family: var(--font-sans);
    font-size: var(--body-sm-size);
    line-height: var(--body-sm-lh);
    text-decoration: none;
    transition: var(--transition-tint);
  }

  .ds-footer__link:hover {
    color: var(--text-on-dark);
  }

  .ds-footer__note {
    border-top: 1px solid var(--hairline-on-dark);
    grid-column: 1 / -1;
    color: var(--text-on-dark-soft);
    font-family: var(--font-sans);
    font-size: var(--body-sm-size);
    line-height: var(--body-sm-lh);
    margin: 0;
    padding-top: var(--space-lg);
  }

  .ds-footer__note :global(a) {
    color: var(--text-on-dark);
  }

  @media (max-width: 768px) {
    .ds-footer__inner {
      gap: var(--space-xxl);
      grid-template-columns: minmax(0, 1fr);
    }

    .ds-footer__grid {
      gap: var(--space-xl);
      grid-auto-flow: row;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
