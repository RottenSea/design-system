---
/**
 * A popover with the theme (through the theme store) and Reduce motion, which it owns as
 * data-reduce-motion on <html>. Give ThemeScript the same keys. When the OS asks for reduced
 * motion, the switch shows on and cannot be turned off.
 */
import IconButton from "../buttons/IconButton.astro";
import SegmentedControl from "../forms/SegmentedControl.astro";
import Switch from "../forms/Switch.astro";

interface Props {
  /** The localStorage key for the theme; ThemeScript reads the same one. */
  storageKey?: string;
  /** The localStorage key for Reduce motion; ThemeScript reads the same one. */
  motionKey?: string;
  /** The panel's id, unique on the page. */
  id?: string;
  /** The button's and the panel's accessible name. */
  label?: string;
  tone?: "canvas" | "dark";
  class?: string;
}

const {
  storageKey = "ds-theme",
  motionKey = "ds-reduce-motion",
  id = "ds-settings",
  label = "Display settings",
  tone = "canvas",
  class: className
} = Astro.props;
---

<ds-settings
  class:list={["ds-settings", className]}
  data-storage-key={storageKey}
  data-motion-key={motionKey}
>
  <IconButton icon="adjustments" label={label} tone={tone} popovertarget={id} aria-haspopup="dialog" />
  <div id={id} popover class="ds-settings__panel" role="dialog" aria-label={label}>
    <p class="ds-settings__heading">Theme</p>
    <SegmentedControl
      label="Theme"
      value="system"
      options={[
        { value: "light", label: "Light" },
        { value: "dark", label: "Dark" },
        { value: "system", label: "System" }
      ]}
      class="ds-settings__theme"
    />
    <Switch label="Reduce motion" description="Fades and slides finish at once." class="ds-settings__motion" />
  </div>
</ds-settings>

<script>
  import { type ThemePreference, themeStore } from "../../scripts/theme";

  type Selectable = HTMLElement & { select(value: string | null): void };
  type Toggle = HTMLElement & { checked: boolean; disabled: boolean };

  const read = (key: string) => {
    try {
      return localStorage.getItem(key);
    } catch {
      return null;
    }
  };
  const write = (key: string, value: string | null) => {
    try {
      if (value === null) localStorage.removeItem(key);
      else localStorage.setItem(key, value);
    } catch {
      // Private browsing can refuse storage; the setting still applies to this page.
    }
  };

  class DsSettings extends HTMLElement {
    connectedCallback() {
      const store = themeStore(this.dataset.storageKey);
      const motionKey = this.dataset.motionKey ?? "ds-reduce-motion";
      const root = document.documentElement;
      const calm = matchMedia("(prefers-reduced-motion: reduce)");
      const theme = this.querySelector<Selectable>(".ds-settings__theme");
      const motion = this.querySelector<Toggle>(".ds-settings__motion");
      const button = this.querySelector<HTMLButtonElement>("button[popovertarget]");
      const panel = this.querySelector<HTMLElement>("[popover]");

      const showMotion = () => {
        if (!motion) return;
        motion.disabled = calm.matches;
        motion.checked = calm.matches || read(motionKey) === "true";
      };

      theme?.select(store.get().preference);
      showMotion();
      theme?.addEventListener("ds-change", (event) => {
        store.set((event as CustomEvent<ThemePreference>).detail);
      });
      // A ThemeToggle, another tab or the OS can change the theme too.
      store.subscribe((state) => theme?.select(state.preference));
      motion?.addEventListener("ds-change", (event) => {
        const on = (event as CustomEvent<boolean>).detail;
        write(motionKey, on ? "true" : null);
        if (on) root.dataset.reduceMotion = "true";
        else delete root.dataset.reduceMotion;
      });
      calm.addEventListener("change", showMotion);

      // Right-aligned under the button, 8px inside the window; the width is fixed in CSS.
      panel?.addEventListener("beforetoggle", (event) => {
        if ((event as ToggleEvent).newState !== "open" || !button) return;
        const box = button.getBoundingClientRect();
        const room = document.documentElement.clientWidth;
        const width = Math.min(Number.parseFloat(getComputedStyle(panel).width) || 280, room - 16);
        panel.style.top = `${box.bottom + 8}px`;
        panel.style.left = `${Math.min(Math.max(8, box.right - width), room - width - 8)}px`;
      });
      panel?.addEventListener("toggle", (event) => {
        button?.setAttribute("aria-expanded", String((event as ToggleEvent).newState === "open"));
      });
      window.addEventListener("resize", () => panel?.hidePopover(), { passive: true });
    }
  }

  if (!customElements.get("ds-settings")) customElements.define("ds-settings", DsSettings);
</script>

<style>
  .ds-settings {
    display: inline-flex;
  }

  .ds-settings__panel {
    background: var(--surface-canvas);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-float);
    box-sizing: border-box;
    color: var(--text-body);
    flex-direction: column;
    gap: var(--space-md);
    inset: auto;
    margin: 0;
    max-width: calc(100vw - 16px);
    opacity: 0;
    padding: var(--space-md);
    position: fixed;
    transition:
      opacity var(--motion-fast) var(--ease-enter),
      overlay var(--motion-fast) allow-discrete,
      display var(--motion-fast) allow-discrete;
    width: 280px;
  }

  .ds-settings__panel:popover-open {
    display: flex;
    opacity: 1;
  }

  @starting-style {
    .ds-settings__panel:popover-open {
      opacity: 0;
    }
  }

  .ds-settings__heading {
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: var(--caption-upper-size);
    font-weight: var(--caption-upper-weight);
    letter-spacing: var(--caption-upper-ls);
    line-height: var(--caption-upper-lh);
    margin: 0 0 calc(-1 * var(--space-xs));
    text-transform: uppercase;
  }

  .ds-settings__panel > :global(.ds-settings__theme) {
    display: flex;
  }

  .ds-settings__panel > :global(.ds-settings__motion) {
    border-top: 1px solid var(--hairline-soft);
    padding-top: var(--space-md);
  }
</style>
