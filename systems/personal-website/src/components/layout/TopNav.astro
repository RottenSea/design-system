---
/**
 * The nav bar at the top of every page: a few links on the left, the site's mark and name in the
 * middle, and actions on the right. The three stay within the container's 1200px, so on a wide
 * window the links and the actions line up with the content instead of running out to the edges.
 * 64px tall on the canvas, with no border and no shadow; the current page's link is ink and the
 * rest are muted. Below 768px the links give way to a menu button that opens a sheet holding
 * them, so a page with only a TopNav still has working small-screen navigation, and the brand
 * moves to the left as the mark alone (the name stays for screen readers); without a mark in the
 * `logo` slot it keeps the name. A page with grouped navigation mounts a NavDrawer and passes its
 * id as `menu`.
 *
 * `overlay` is for a page that opens on a full-height band such as QuoteBand: the nav is fixed,
 * takes no height, and starts transparent over the band. Over the first `ramp` pixels of scroll
 * the wash, the blur and the hairline come up together, written out at every step so nothing
 * appears at a threshold; the text colours switch once, halfway. With reduced motion the ramp
 * becomes two states. Without backdrop-filter the bar is near-opaque past halfway.
 *
 * Ported from the handoff's TopNav.jsx, with links as { label, href } and the current one named
 * by `active`. The nav measures the scroll itself instead of taking `scrollProgress`. Left out:
 * `signInLabel` and `ctaLabel`; a site's own buttons go in the `actions` slot. The handoff puts
 * the brand on the left; this system centres it (2026-11-03).
 *
 *   <TopNav brand="The Key of Urala" links={[{ label: "Blog", href: "/" }]} active="Blog">
 *     <Logo slot="logo" width={24} height={24} aria-hidden="true" />
 *     <ThemeToggle slot="actions" />
 *   </TopNav>
 */
import IconButton from "../buttons/IconButton.astro";
import MenuPanel, { type MenuGroup, type MenuLink } from "./MenuPanel.astro";

interface Props {
  brand: string;
  brandHref?: string;
  links: MenuLink[];
  /** Label of the current page's link. */
  active?: string;
  /** "uppercase" draws the links as micro-labels. */
  linkStyle?: "sentence" | "uppercase";
  /** Id of a NavDrawer the menu button opens. Without it the nav carries its own sheet. */
  menu?: string;
  /** Groups for the nav's own sheet; by default one group of `links`. */
  menuGroups?: MenuGroup[];
  /** A line at the bottom of the nav's own sheet. */
  menuNote?: string;
  /** Fixed and transparent over a full-height band until the page scrolls. */
  overlay?: boolean;
  /** The text colours over the band: `on-dark` for a dark band. */
  overlayTone?: "ink" | "on-dark";
  /** The bar's own surface once scrolled. */
  scrolledTone?: "cream" | "dark";
  /** The scroll, in px, over which the bar comes up. */
  ramp?: number;
  class?: string;
}

const {
  brand,
  brandHref = "/",
  links,
  active,
  linkStyle = "sentence",
  menu,
  menuGroups,
  menuNote,
  overlay = false,
  overlayTone = "ink",
  scrolledTone = "cream",
  ramp = 120,
  class: className
} = Astro.props;
const ownMenu = menu === undefined;
const hasLogo = Astro.slots.has("logo");
const menuId = menu ?? `ds-nav-menu-${crypto.randomUUID().slice(0, 8)}`;
---

<ds-top-nav
  class:list={[
    "ds-nav",
    {
      "ds-nav--overlay": overlay,
      "ds-nav--over-dark": overlay && overlayTone === "on-dark",
      "ds-nav--dark": scrolledTone === "dark",
      "ds-nav--has-logo": hasLogo
    },
    className
  ]}
  role="banner"
  data-ramp={overlay ? ramp : undefined}
  data-floating={overlay ? "" : undefined}
  style={overlay ? "--ds-nav-p: 0" : undefined}
>
  <div class="ds-nav__inner">
    <a class="ds-nav__brand" href={brandHref}>
      <slot name="logo" />
      <span class="ds-nav__brand-name">{brand}</span>
    </a>
    <nav class:list={["ds-nav__links", { "ds-nav__links--upper": linkStyle === "uppercase" }]} aria-label="Site">
      {
        links.map((link) => (
          <a class="ds-nav__link" href={link.href} aria-current={link.label === active ? "page" : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="ds-nav__actions">
      <slot name="actions" />
      <span class="ds-nav__burger">
        <IconButton icon="menu" label="Menu" aria-haspopup="dialog" aria-expanded="false" data-ds-menu-open={menuId} />
      </span>
    </div>
  </div>
  {
    ownMenu && (
      <MenuPanel id={menuId} brand={brand} groups={menuGroups ?? [{ links }]} active={active} note={menuNote}>
        <slot name="logo" slot="logo" />
      </MenuPanel>
    )
  }
</ds-top-nav>

<script>
  class DsTopNav extends HTMLElement {
    connectedCallback() {
      const ramp = Number(this.dataset.ramp);
      if (!ramp) return;
      const reduced = () =>
        matchMedia("(prefers-reduced-motion: reduce)").matches ||
        document.documentElement.dataset.reduceMotion === "true";
      let frame = 0;
      const update = () => {
        frame = 0;
        const raw = Math.min(Math.max(window.scrollY / ramp, 0), 1);
        const progress = reduced() ? Math.round(raw) : raw;
        this.style.setProperty("--ds-nav-p", progress.toFixed(3));
        this.toggleAttribute("data-floating", progress <= 0.5);
      };
      update();
      window.addEventListener(
        "scroll",
        () => {
          if (!frame) frame = requestAnimationFrame(update);
        },
        { passive: true }
      );
    }
  }

  if (!customElements.get("ds-top-nav")) customElements.define("ds-top-nav", DsTopNav);
</script>

<style>
  .ds-nav {
    background: var(--surface-canvas);
    --ds-nav-ink: var(--text-ink);
    --ds-nav-muted: var(--text-muted);
    color: var(--ds-nav-ink);
    box-sizing: border-box;
    display: block;
    height: var(--nav-height);
    padding: 0 var(--space-lg);
  }

  /* The brand comes first for screen readers and the keyboard, and sits in the middle column.
     Equal outer columns keep it centred whatever the links and the actions take. */
  .ds-nav__inner {
    align-items: center;
    display: grid;
    gap: var(--space-xl);
    grid-template-areas: "links brand actions";
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    height: 100%;
    margin-inline: auto;
    max-width: var(--container-max);
  }

  .ds-nav__brand {
    align-items: center;
    display: flex;
    gap: var(--space-xs);
    grid-area: brand;
    text-decoration: none;
  }

  .ds-nav__brand > :global(svg),
  .ds-nav__brand > :global(img) {
    flex: 0 0 auto;
  }

  .ds-nav__brand-name {
    color: var(--ds-nav-ink);
    transition: var(--transition-tint);
    font-family: var(--font-sans);
    font-size: var(--title-sm-size);
    font-weight: 500;
  }

  .ds-nav__links {
    align-items: center;
    display: flex;
    gap: var(--space-lg);
    grid-area: links;
    justify-self: start;
  }

  .ds-nav__link {
    color: var(--ds-nav-muted);
    font-family: var(--font-sans);
    font-size: var(--nav-link-size);
    font-weight: var(--nav-link-weight);
    line-height: var(--nav-link-lh);
    text-decoration: none;
    transition: var(--transition-tint);
  }

  .ds-nav__links--upper .ds-nav__link {
    font-size: var(--caption-upper-size);
    font-weight: var(--caption-upper-weight);
    letter-spacing: var(--caption-upper-ls);
    line-height: var(--caption-upper-lh);
    text-transform: uppercase;
  }

  .ds-nav__link:hover,
  .ds-nav__link[aria-current="page"] {
    color: var(--ds-nav-ink);
  }

  /* Overlay: fixed over the band, its surface ramping with --ds-nav-p (0 to 1). */
  .ds-nav--overlay {
    -webkit-backdrop-filter: saturate(calc(100% + 60% * var(--ds-nav-p))) blur(calc(12px * var(--ds-nav-p)));
    backdrop-filter: saturate(calc(100% + 60% * var(--ds-nav-p))) blur(calc(12px * var(--ds-nav-p)));
    background: color-mix(in srgb, var(--surface-blur-cream) calc(var(--ds-nav-p) * 100%), transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--hairline) calc(var(--ds-nav-p) * 100%), transparent);
    left: 0;
    position: fixed;
    right: 0;
    top: 0;
    z-index: 40;
  }

  .ds-nav--overlay.ds-nav--dark {
    background: color-mix(in srgb, var(--surface-blur-dark) calc(var(--ds-nav-p) * 100%), transparent);
    border-bottom-color: color-mix(in srgb, var(--hairline-on-dark) calc(var(--ds-nav-p) * 100%), transparent);
  }

  /* Text colours switch once: over a dark band while floating, and on a dark bar once scrolled. */
  .ds-nav--over-dark[data-floating],
  .ds-nav--overlay.ds-nav--dark:not([data-floating]) {
    --ds-nav-ink: var(--text-on-dark);
    --ds-nav-muted: var(--text-on-dark-soft);
  }

  @supports not (backdrop-filter: blur(1px)) {
    .ds-nav--overlay:not([data-floating]) {
      background: var(--surface-blur-cream-opaque);
    }

    .ds-nav--overlay.ds-nav--dark:not([data-floating]) {
      background: var(--surface-blur-dark-opaque);
    }
  }

  .ds-nav__actions {
    align-items: center;
    display: flex;
    gap: var(--space-xs);
    grid-area: actions;
    justify-self: end;
  }

  .ds-nav__burger {
    display: none;
  }

  @media (max-width: 768px) {
    .ds-nav__inner {
      gap: var(--space-md);
      grid-template-areas: "brand actions";
      grid-template-columns: auto minmax(0, 1fr);
    }

    .ds-nav__links {
      display: none;
    }

    .ds-nav__burger {
      display: inline-flex;
    }

    /* The mark alone; the name is still the link's name. */
    .ds-nav--has-logo .ds-nav__brand-name {
      clip-path: inset(50%);
      height: 1px;
      overflow: hidden;
      position: absolute;
      white-space: nowrap;
      width: 1px;
    }
  }
</style>
