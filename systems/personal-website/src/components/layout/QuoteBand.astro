---
/**
 * A full-window opening quote at the top of a page, with a hint that scrolls to what follows. With
 * `autoSize` the size steps down by length (up to 90 characters display-lg, 180 display-md).
 * `pullNext` makes the next element rise over the band faster than the page scrolls.
 */
import ChevronDown from "../../icons/chevron-down.svg";

export interface Quote {
  text: string;
  attribution?: string;
}

interface Props {
  eyebrow?: string;
  /** The quote, when there is one; the slot takes it too. */
  attribution?: string;
  /** Several quotes, one shown at random on each visit. */
  quotes?: Quote[];
  /** `bare` paints no background, for a page that has its own behind the band. */
  tone?: "cream" | "dark" | "bare";
  /** With `bare`, the text colours: for a dark page behind, or a light one. */
  overlayTone?: "ink" | "on-dark";
  /** The quote's line length. */
  measure?: string;
  autoSize?: boolean;
  /** The hint's text; false drops the hint. */
  scrollHint?: string | false;
  /** "none" draws the chevron alone, with the text as its accessible name. */
  hintLabel?: "text" | "none";
  minHeight?: string;
  pullNext?: boolean;
  class?: string;
}

const {
  eyebrow,
  attribution,
  quotes,
  tone = "cream",
  overlayTone = "on-dark",
  measure = "34ch",
  autoSize = true,
  scrollHint = "Scroll",
  hintLabel = "text",
  minHeight = "100svh",
  pullNext = false,
  class: className
} = Astro.props;

const step = (length: number) =>
  !autoSize || length <= 90 ? "lg" : length <= 180 ? "md" : "sm";
const first = quotes?.[0];
const slotText = first ? "" : await Astro.slots.render("default");
const length = first
  ? first.text.length
  : slotText.replace(/<[^>]*>/g, "").trim().length;
const shownAttribution = first ? first.attribution : attribution;
const dark = tone === "dark" || (tone === "bare" && overlayTone === "on-dark");
// In a <script>, a quote holding "</script>" would end the element; < is the same < to JSON.
const quotesJson = JSON.stringify(quotes ?? []).replace(/</g, "\\u003c");

/*
 * Picks the quote while the page is still parsing, before the first paint: a module script runs
 * after it, when the first quote, the one in the HTML, has already been drawn.
 */
const PICK = `(function (band) {
  var data = band.querySelector("[data-ds-quotes]");
  var text = band.querySelector(".ds-quote-band__quote");
  var source = band.querySelector(".ds-quote-band__source");
  if (!data || !text || !source) return;
  var quotes = JSON.parse(data.textContent || "[]");
  var quote = quotes[Math.floor(Math.random() * quotes.length)];
  if (!quote) return;
  var length = quote.text.length;
  var size = !band.hasAttribute("data-auto-size") || length <= 90 ? "lg" : length <= 180 ? "md" : "sm";
  text.textContent = quote.text;
  /* classList: a site that scopes styles by class (Starlight) keeps the scope class. */
  text.classList.remove("ds-quote-band__quote--lg", "ds-quote-band__quote--md", "ds-quote-band__quote--sm");
  text.classList.add("ds-quote-band__quote--" + size);
  source.textContent = quote.attribution || "";
  source.hidden = !quote.attribution;
})(document.currentScript.parentElement);`;
---

<ds-quote-band
  class:list={[
    "ds-quote-band",
    `ds-quote-band--${tone}`,
    { "ds-quote-band--on-dark": dark },
    className
  ]}
  style={`--ds-quote-min: ${minHeight}; --ds-quote-measure: ${measure}`}
  data-pull-next={pullNext ? "" : undefined}
  data-auto-size={autoSize ? "" : undefined}
>
  <section class="ds-quote-band__inner">
    {eyebrow && <span class="ds-quote-band__eyebrow">{eyebrow}</span>}
    <figure class="ds-quote-band__figure">
      <blockquote class={`ds-quote-band__quote ds-quote-band__quote--${step(length)}`}>
        {first ? first.text : <Fragment set:html={slotText} />}
      </blockquote>
      <figcaption class="ds-quote-band__source" hidden={!shownAttribution}>{shownAttribution}</figcaption>
    </figure>
  </section>
  {
    scrollHint && (
      <button
        type="button"
        class="ds-quote-band__hint"
        aria-label={hintLabel === "none" ? scrollHint : undefined}
        data-ds-quote-hint
      >
        {hintLabel !== "none" && <span class="ds-quote-band__hint-text">{scrollHint}</span>}
        <ChevronDown width={20} height={20} aria-hidden="true" />
      </button>
    )
  }
  {quotes && quotes.length > 1 && <script type="application/json" data-ds-quotes set:html={quotesJson} />}
  {quotes && quotes.length > 1 && <script is:inline set:html={PICK} />}
</ds-quote-band>

<script>
  class DsQuoteBand extends HTMLElement {
    connectedCallback() {
      this.querySelector("[data-ds-quote-hint]")?.addEventListener("click", () => {
        // Astro writes this component's script right after it in a built page; skip it.
        let next = this.nextElementSibling as HTMLElement | null;
        while (next?.matches("script, template, style")) next = next.nextElementSibling as HTMLElement | null;
        if (!next) return;
        const reduce =
          matchMedia("(prefers-reduced-motion: reduce)").matches ||
          document.documentElement.dataset.reduceMotion === "true";
        // Its layout position, not where pullNext draws it, less a TopNav that stays over the page.
        let top = 0;
        for (let element: HTMLElement | null = next; element; element = element.offsetParent as HTMLElement | null) {
          top += element.offsetTop;
        }
        const nav = document.querySelector<HTMLElement>(".ds-nav");
        const position = nav ? getComputedStyle(nav).position : "";
        if (nav && (position === "fixed" || position === "sticky")) top -= nav.offsetHeight;
        window.scrollTo({ top, behavior: reduce ? "auto" : "smooth" });
      });
    }
  }

  if (!customElements.get("ds-quote-band")) customElements.define("ds-quote-band", DsQuoteBand);
</script>

<style>
  .ds-quote-band {
    align-items: center;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: var(--ds-quote-min);
    overflow: hidden;
    padding: var(--space-section) var(--space-lg);
    position: relative;
    text-align: center;
  }

  .ds-quote-band--cream {
    background: var(--surface-canvas);
  }

  .ds-quote-band--dark {
    background: var(--surface-dark);
  }

  .ds-quote-band__inner {
    align-items: center;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    max-width: 100%;
  }

  .ds-quote-band__eyebrow {
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: var(--caption-upper-size);
    font-weight: var(--caption-upper-weight);
    letter-spacing: var(--caption-upper-ls);
    line-height: var(--caption-upper-lh);
    text-transform: uppercase;
  }

  .ds-quote-band__figure {
    align-items: center;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    margin: 0;
  }

  .ds-quote-band__quote {
    color: var(--text-ink);
    font-family: var(--font-display);
    font-weight: 400;
    margin: 0;
    max-width: var(--ds-quote-measure);
    text-wrap: pretty;
  }

  .ds-quote-band__quote--lg {
    font-size: var(--display-lg-size);
    letter-spacing: var(--display-lg-ls);
    line-height: var(--display-lg-lh);
  }

  .ds-quote-band__quote--md {
    font-size: var(--display-md-size);
    letter-spacing: var(--display-md-ls);
    line-height: var(--display-md-lh);
  }

  .ds-quote-band__quote--sm {
    font-size: var(--display-sm-size);
    letter-spacing: var(--display-sm-ls);
    line-height: var(--display-sm-lh);
  }

  .ds-quote-band__source {
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: var(--body-md-size);
    line-height: var(--body-md-lh);
  }

  .ds-quote-band__hint {
    align-items: center;
    background: none;
    border: 0;
    bottom: var(--space-lg);
    color: var(--text-muted);
    cursor: pointer;
    display: flex;
    flex-direction: column;
    font: inherit;
    gap: var(--space-xxs);
    justify-content: center;
    left: 50%;
    min-height: calc(var(--space-xl) + var(--space-sm));
    min-width: calc(var(--space-xl) + var(--space-sm));
    padding: 0;
    position: absolute;
    transform: translateX(-50%);
  }

  .ds-quote-band__hint-text {
    font-family: var(--font-sans);
    font-size: var(--caption-upper-size);
    font-weight: var(--caption-upper-weight);
    letter-spacing: var(--caption-upper-ls);
    line-height: var(--caption-upper-lh);
    text-transform: uppercase;
  }

  .ds-quote-band--on-dark .ds-quote-band__quote {
    color: var(--text-on-dark);
  }

  .ds-quote-band--on-dark :is(.ds-quote-band__eyebrow, .ds-quote-band__source, .ds-quote-band__hint) {
    color: var(--text-on-dark-soft);
  }

  /* pullNext: laid out 40svh up and drawn 40svh down, an offset that eases out over 60svh of scroll. */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      /* The element after the band, or after the script Astro writes there in a built page. */
      :global(:root:not([data-reduce-motion="true"])) .ds-quote-band[data-pull-next] + :global(:not(script)),
      :global(:root:not([data-reduce-motion="true"])) .ds-quote-band[data-pull-next] + :global(script + *) {
        /* Longhands only: given the `animation` shorthand, the build's minifier folds the timeline
           into it, where browsers reject it, and the whole animation is lost. */
        animation-fill-mode: both;
        animation-name: ds-quote-pull;
        animation-range: 0 60svh;
        animation-timeline: scroll(root block);
        animation-timing-function: cubic-bezier(0.2, 0.8, 0.4, 1);
        background: var(--surface-canvas);
        margin-top: -40svh;
        position: relative;
        /* Where the animation starts, for any moment its timeline is not active yet. */
        transform: translateY(40svh);
        z-index: 1;
      }
    }
  }

  @keyframes ds-quote-pull {
    from {
      transform: translateY(40svh);
    }

    to {
      transform: none;
    }
  }
</style>
