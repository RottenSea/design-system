---
/**
 * Search without leaving the page: a 560px panel under the nav line over a scrim, a 56px input
 * row, then the results, each a title, a meta line and the matching sentence. The row under the
 * arrow keys sits on the cream card. Skeleton lines show while results load, and one sentence
 * when nothing matches.
 *
 * Ported from the handoff's SearchPanel.jsx. Like the handoff's, it never fetches: the page owns
 * the index. Instead of props and callbacks it sends `ds-open` when it opens (load the index
 * then) and `ds-query` with the text as it changes, and the page answers with `setLoading()`
 * and `setResults()`. It is a native modal <dialog>: the focus goes to the input and stays in
 * the panel, Escape and a click on the scrim close it. Arrow keys move through the results with
 * the focus left in the input, and Enter opens the one marked. Any element with
 * data-ds-search-open set to the panel's id opens it, and so do "/" and Ctrl+K or ⌘K unless
 * `shortcuts` is false.
 *
 *   <IconButton icon="search" label="Search" data-ds-search-open="site-search" />
 *   <SearchPanel id="site-search" />
 *   panel.addEventListener("ds-query", async (event) => panel.setResults(await find(event.detail)));
 */
import SearchIcon from "../../icons/search.svg";
import X from "../../icons/x.svg";

export interface SearchResult {
  title: string;
  href: string;
  /** The second line: date, category. */
  meta?: string;
  /** The matching text. Its <mark> elements are kept; any other markup is shown as text. */
  excerpt?: string;
  /** An uppercase micro-label that starts a group; rows in a row with the same one share it. */
  group?: string;
}

interface Props {
  id: string;
  placeholder?: string;
  /** What shows when a query finds nothing. */
  emptyLabel?: string;
  /** The line at the bottom: key hints. */
  hint?: string;
  /** Opens the panel with "/" and Ctrl+K or ⌘K. */
  shortcuts?: boolean;
  class?: string;
}

const {
  id,
  placeholder = "Search",
  emptyLabel = "No matches",
  hint = "↑↓ to move · Enter to open · Esc to close",
  shortcuts = true,
  class: className
} = Astro.props;
---

<ds-search-panel data-shortcuts={shortcuts ? "" : undefined} data-empty={emptyLabel}>
  <dialog id={id} class:list={["ds-search", className]} aria-label="Search">
    <div class="ds-search__panel">
      <div class="ds-search__field">
        <SearchIcon class="ds-search__icon" width={20} height={20} aria-hidden="true" />
        <input
          class="ds-search__input"
          type="search"
          placeholder={placeholder}
          autocomplete="off"
          spellcheck="false"
          role="combobox"
          aria-label="Search"
          aria-autocomplete="list"
          aria-expanded="false"
          aria-controls={`${id}-results`}
        />
        <button type="button" class="ds-search__close" aria-label="Close search" data-ds-tap="cell">
          <X width={18} height={18} aria-hidden="true" />
        </button>
      </div>
      <div class="ds-search__body">
        <div class="ds-search__results" id={`${id}-results`} role="listbox" aria-label="Results"></div>
        <div class="ds-search__loading" hidden aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
        <p class="ds-search__status" role="status"></p>
      </div>
      {hint && <p class="ds-search__hint">{hint}</p>}
    </div>
  </dialog>
</ds-search-panel>

<script>
  interface SearchResult {
    title: string;
    href: string;
    meta?: string;
    excerpt?: string;
    group?: string;
  }

  /** Escapes markup, then lets <mark> and </mark> back in. */
  const marked = (html: string) =>
    html
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/&lt;(\/?)mark&gt;/g, "<$1mark>");

  class DsSearchPanel extends HTMLElement {
    #dialog!: HTMLDialogElement;
    #input!: HTMLInputElement;
    #list!: HTMLElement;
    #status!: HTMLElement;
    #loading!: HTMLElement;
    #active = -1;

    connectedCallback() {
      const dialog = this.querySelector("dialog");
      const input = this.querySelector<HTMLInputElement>(".ds-search__input");
      const list = this.querySelector<HTMLElement>(".ds-search__results");
      const status = this.querySelector<HTMLElement>(".ds-search__status");
      const loading = this.querySelector<HTMLElement>(".ds-search__loading");
      if (!dialog || !input || !list || !status || !loading) return;
      this.#dialog = dialog;
      this.#input = input;
      this.#list = list;
      this.#status = status;
      this.#loading = loading;

      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
      this.querySelector(".ds-search__close")?.addEventListener("click", () => dialog.close());
      input.addEventListener("input", () => {
        this.dispatchEvent(new CustomEvent("ds-query", { detail: input.value.trim(), bubbles: true }));
      });
      input.addEventListener("keydown", (event) => {
        const links = this.#links();
        if (event.key === "ArrowDown" || event.key === "ArrowUp") {
          event.preventDefault();
          if (links.length) this.#mark((this.#active + (event.key === "ArrowDown" ? 1 : -1) + links.length) % links.length);
        } else if (event.key === "Enter" && links[this.#active]) {
          event.preventDefault();
          links[this.#active].click();
        }
      });
      list.addEventListener("pointermove", (event) => {
        const link = (event.target as Element).closest<HTMLAnchorElement>("a[role=option]");
        if (link) this.#mark(this.#links().indexOf(link));
      });
      // Following a result leaves the page; close first so Back returns to it closed.
      list.addEventListener("click", (event) => {
        if ((event.target as Element).closest("a")) dialog.close();
      });
      dialog.addEventListener("close", () => {
        const opener = document.querySelector<HTMLElement>(`[data-ds-search-open="${dialog.id}"]`);
        opener?.setAttribute("aria-expanded", "false");
      });

      document.addEventListener("click", (event) => {
        const opener = (event.target as Element).closest<HTMLElement>("[data-ds-search-open]");
        if (opener?.dataset.dsSearchOpen === dialog.id) this.open();
      });
      if (this.hasAttribute("data-shortcuts")) {
        document.addEventListener("keydown", (event) => {
          if (dialog.open) return;
          const target = event.target as HTMLElement;
          const typing = target.closest("input, textarea, select, [contenteditable]:not([contenteditable=false])");
          const slash = event.key === "/" && !typing && !event.ctrlKey && !event.metaKey && !event.altKey;
          const k = event.key.toLowerCase() === "k" && (event.ctrlKey || event.metaKey) && !event.altKey;
          if (slash || k) {
            event.preventDefault();
            this.open();
          }
        });
      }
    }

    /** Opens the panel with the focus in the input, and sends ds-open. */
    open() {
      if (this.#dialog.open) return;
      this.#dialog.showModal();
      this.#input.focus();
      this.#input.select();
      document
        .querySelector<HTMLElement>(`[data-ds-search-open="${this.#dialog.id}"]`)
        ?.setAttribute("aria-expanded", "true");
      this.dispatchEvent(new CustomEvent("ds-open", { bubbles: true }));
    }

    close() {
      this.#dialog.close();
    }

    /** Shows the skeleton lines in place of the results. */
    setLoading(loading: boolean) {
      this.#loading.hidden = !loading;
      if (loading) {
        this.#list.replaceChildren();
        this.#status.textContent = "";
      }
    }

    /**
     * Shows these results. With none, it shows `message`, or the empty label when the input has
     * text, or nothing.
     */
    setResults(results: SearchResult[], message?: string) {
      this.#loading.hidden = true;
      this.#active = -1;
      this.#input.removeAttribute("aria-activedescendant");
      const id = this.#list.id;
      let group: string | undefined;
      const rows: HTMLElement[] = [];
      results.forEach((result, index) => {
        if (result.group && result.group !== group) {
          const head = document.createElement("p");
          head.className = "ds-search__group";
          head.setAttribute("role", "presentation");
          head.textContent = result.group;
          rows.push(head);
        }
        group = result.group ?? group;
        const link = document.createElement("a");
        link.className = "ds-search__row";
        link.href = result.href;
        link.id = `${id}-${index}`;
        link.setAttribute("role", "option");
        link.setAttribute("aria-selected", "false");
        link.tabIndex = -1;
        const title = document.createElement("span");
        title.className = "ds-search__title";
        title.textContent = result.title;
        link.append(title);
        if (result.meta) {
          const meta = document.createElement("span");
          meta.className = "ds-search__meta";
          meta.textContent = result.meta;
          link.append(meta);
        }
        if (result.excerpt) {
          const excerpt = document.createElement("span");
          excerpt.className = "ds-search__excerpt";
          excerpt.innerHTML = marked(result.excerpt);
          link.append(excerpt);
        }
        rows.push(link);
      });
      this.#list.replaceChildren(...rows);
      this.#input.setAttribute("aria-expanded", String(results.length > 0));
      this.#status.textContent = results.length
        ? ""
        : (message ?? (this.#input.value.trim() ? (this.dataset.empty ?? "No matches") : ""));
      if (results.length) this.#mark(0);
    }

    #links() {
      return [...this.#list.querySelectorAll<HTMLAnchorElement>("a[role=option]")];
    }

    #mark(index: number) {
      const links = this.#links();
      links[this.#active]?.setAttribute("aria-selected", "false");
      this.#active = index;
      const link = links[index];
      if (!link) return;
      link.setAttribute("aria-selected", "true");
      this.#input.setAttribute("aria-activedescendant", link.id);
      link.scrollIntoView({ block: "nearest" });
    }
  }

  if (!customElements.get("ds-search-panel")) customElements.define("ds-search-panel", DsSearchPanel);
</script>

<style>
  .ds-search {
    background: transparent;
    border: 0;
    box-sizing: border-box;
    height: 100%;
    margin: 0;
    max-height: none;
    max-width: none;
    opacity: 0;
    padding: calc(var(--nav-height) + var(--space-lg)) var(--space-lg) var(--space-lg);
    transition:
      opacity var(--motion-base) var(--ease-enter),
      overlay var(--motion-base) allow-discrete,
      display var(--motion-base) allow-discrete;
    width: 100%;
  }

  .ds-search[open] {
    display: flex;
    justify-content: center;
    opacity: 1;
  }

  .ds-search::backdrop {
    background: rgba(20, 20, 19, 0.45);
    opacity: 0;
    transition:
      opacity var(--motion-base) var(--ease-enter),
      overlay var(--motion-base) allow-discrete,
      display var(--motion-base) allow-discrete;
  }

  .ds-search[open]::backdrop {
    opacity: 1;
  }

  @starting-style {
    .ds-search[open],
    .ds-search[open]::backdrop {
      opacity: 0;
    }
  }

  .ds-search__panel {
    align-self: flex-start;
    background: var(--surface-canvas);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-float);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    max-height: 100%;
    overflow: hidden;
    transition: transform var(--motion-base) var(--ease-enter);
    width: min(560px, 100%);
  }

  @starting-style {
    .ds-search[open] .ds-search__panel {
      transform: translateY(var(--motion-shift));
    }
  }

  .ds-search__field {
    align-items: center;
    border-bottom: 1px solid var(--hairline-soft);
    display: flex;
    flex: 0 0 auto;
    gap: var(--space-sm);
    height: 56px;
    padding: 0 var(--space-md);
  }

  .ds-search__icon {
    color: var(--text-muted);
    flex: 0 0 auto;
  }

  .ds-search__input {
    appearance: none;
    background: transparent;
    border: 0;
    color: var(--text-ink);
    flex: 1;
    font-family: var(--font-sans);
    font-size: var(--body-md-size);
    min-width: 0;
    outline: none;
  }

  .ds-search__input::-webkit-search-cancel-button {
    display: none;
  }

  .ds-search__close {
    align-items: center;
    background: transparent;
    border: 0;
    color: var(--text-muted);
    cursor: pointer;
    display: inline-flex;
    height: 24px;
    justify-content: center;
    padding: 0;
    width: 24px;
  }

  .ds-search__body {
    min-height: 0;
    overflow-y: auto;
    padding: var(--space-xs);
  }

  .ds-search__results {
    display: flex;
    flex-direction: column;
  }

  .ds-search__results :global(.ds-search__group) {
    color: var(--text-muted-soft);
    font-family: var(--font-sans);
    font-size: var(--caption-upper-size);
    font-weight: var(--caption-upper-weight);
    letter-spacing: var(--caption-upper-ls);
    line-height: var(--caption-upper-lh);
    margin: 0;
    padding: var(--space-sm) var(--space-sm) var(--space-xxs);
    text-transform: uppercase;
  }

  .ds-search__results :global(.ds-search__row) {
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-xs) var(--space-sm);
    text-decoration: none;
    transition: var(--transition-tint);
  }

  .ds-search__results :global(.ds-search__row[aria-selected="true"]) {
    background: var(--surface-card);
  }

  .ds-search__results :global(.ds-search__title) {
    color: var(--text-ink);
    font-family: var(--font-sans);
    font-size: var(--body-sm-size);
    font-weight: 500;
  }

  .ds-search__results :global(.ds-search__meta),
  .ds-search__results :global(.ds-search__excerpt) {
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: var(--caption-size);
    line-height: var(--caption-lh);
  }

  .ds-search__results :global(.ds-search__excerpt) {
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    display: -webkit-box;
    overflow: hidden;
  }

  .ds-search__results :global(mark) {
    background: transparent;
    color: var(--text-ink);
    font-weight: 500;
  }

  .ds-search__loading {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-sm);
  }

  .ds-search__loading[hidden] {
    display: none;
  }

  .ds-search__loading span {
    animation: ds-search-pulse 1.2s var(--ease-move) infinite alternate;
    background: var(--surface-card);
    border-radius: var(--radius-xs);
    height: 12px;
  }

  .ds-search__loading span:nth-child(2) {
    width: 80%;
  }

  .ds-search__loading span:nth-child(3) {
    width: 60%;
  }

  @keyframes ds-search-pulse {
    to {
      opacity: 0.5;
    }
  }

  .ds-search__status {
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: var(--body-sm-size);
    margin: 0;
    padding: 0 var(--space-sm);
  }

  .ds-search__status:not(:empty) {
    padding: var(--space-md) var(--space-sm);
  }

  .ds-search__hint {
    border-top: 1px solid var(--hairline-soft);
    color: var(--text-muted);
    flex: 0 0 auto;
    font-family: var(--font-sans);
    font-size: var(--caption-size);
    margin: 0;
    padding: var(--space-xs) var(--space-md);
  }

  @media (max-width: 768px) {
    .ds-search {
      padding: var(--space-md);
    }

    .ds-search__hint {
      display: none;
    }
  }
</style>
