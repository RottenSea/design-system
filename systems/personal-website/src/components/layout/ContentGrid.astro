---
/**
 * The content grid: left rail, main column, right rail, in the `left` and `right` slots. Below
 * 1080px the right rail is hidden, and below 768px it is one column; a missing or empty rail drops
 * its track.
 */
interface Props {
  /** A length; a number is px. */
  leftWidth?: string | number;
  rightWidth?: string | number;
  /** Which rails stick below the nav. "none" for rails taller than the window. */
  sticky?: "both" | "left" | "right" | "none";
  stickyTop?: string;
  /** Space between the columns. */
  gap?: string;
  /** Space between the cards inside a rail. */
  railGap?: string;
  /** Keeps the right rail between 768px and 1080px. */
  keepRails?: boolean;
  /** Which rails stay, stacked under the main column, below 768px. */
  stackRails?: "both" | "left" | "right" | "none";
  maxWidth?: string | number;
  /** A length: the main column's width, kept in the middle of the page. A number is px. */
  mainWidth?: string | number;
  class?: string;
}

const px = (value: string | number) =>
  typeof value === "number" ? `${value}px` : value;

const {
  leftWidth = "var(--rail-left)",
  rightWidth = "var(--rail-right)",
  sticky = "both",
  stickyTop = "calc(var(--nav-height) + var(--space-lg))",
  gap = "var(--space-xxl)",
  railGap = "var(--space-md)",
  keepRails = false,
  stackRails = "both",
  maxWidth = "var(--container-max)",
  mainWidth,
  class: className
} = Astro.props;

// Astro.slots.has is true even for {false && <Fragment slot="right">…}.
const render = async (name: "left" | "right") =>
  Astro.slots.has(name) ? (await Astro.slots.render(name)).trim() : "";
const leftHtml = await render("left");
const rightHtml = await render("right");
const hasLeft = leftHtml !== "";
const hasRight = rightHtml !== "";
const side = (has: boolean, width: string | number) =>
  has ? `minmax(${px(width)}, 1fr)` : "minmax(0, 1fr)";
const columns = mainWidth
  ? `${side(hasLeft, leftWidth)} minmax(0, ${px(mainWidth)}) ${side(hasRight, rightWidth)}`
  : [
      hasLeft ? px(leftWidth) : null,
      "minmax(0, 1fr)",
      hasRight ? px(rightWidth) : null
    ]
      .filter(Boolean)
      .join(" ");
const narrow = mainWidth
  ? `${side(hasLeft, leftWidth)} minmax(0, ${px(mainWidth)}) minmax(0, 1fr)`
  : hasLeft
    ? `${px(leftWidth)} minmax(0, 1fr)`
    : "minmax(0, 1fr)";
const style = [
  `--ds-cgrid-columns: ${columns}`,
  `--ds-cgrid-narrow: ${narrow}`,
  `--ds-cgrid-gap: ${gap}`,
  `--ds-cgrid-rail-gap: ${railGap}`,
  `--ds-cgrid-sticky-top: ${stickyTop}`,
  `--ds-cgrid-max: ${mainWidth ? "none" : px(maxWidth)}`,
  `--ds-cgrid-left: ${px(leftWidth)}`,
  `--ds-cgrid-right: ${px(rightWidth)}`
].join("; ");
const sticks = (side: "left" | "right") => sticky === "both" || sticky === side;
---

<div
  class:list={["ds-cgrid", className]}
  style={style}
  data-keep-rails={keepRails ? "" : undefined}
  data-stack-rails={stackRails === "both" ? undefined : stackRails}
  data-centred={mainWidth ? "" : undefined}
>
  {
    hasLeft && (
      <aside class:list={["ds-cgrid__rail", { "ds-cgrid__rail--sticky": sticks("left") }]} data-rail="left">
        <Fragment set:html={leftHtml} />
      </aside>
    )
  }
  <div class="ds-cgrid__main" data-main>
    <slot />
  </div>
  {
    hasRight && (
      <aside class:list={["ds-cgrid__rail", { "ds-cgrid__rail--sticky": sticks("right") }]} data-rail="right">
        <Fragment set:html={rightHtml} />
      </aside>
    )
  }
</div>

<style>
  .ds-cgrid {
    align-items: start;
    display: grid;
    gap: var(--ds-cgrid-gap);
    grid-template-columns: var(--ds-cgrid-columns);
    margin-inline: auto;
    max-width: var(--ds-cgrid-max);
  }

  .ds-cgrid__rail {
    display: flex;
    flex-direction: column;
    gap: var(--ds-cgrid-rail-gap);
    min-width: 0;
  }

  .ds-cgrid__rail--sticky {
    position: sticky;
    top: var(--ds-cgrid-sticky-top);
  }

  .ds-cgrid__main {
    min-width: 0;
  }

  /* mainWidth: three tracks always, the main column in the middle and each rail against it. */
  .ds-cgrid[data-centred] > .ds-cgrid__main {
    grid-column: 2;
  }

  .ds-cgrid[data-centred] > [data-rail="left"] {
    grid-column: 1;
    justify-self: end;
    width: var(--ds-cgrid-left);
  }

  .ds-cgrid[data-centred] > [data-rail="right"] {
    grid-column: 3;
    justify-self: start;
    width: var(--ds-cgrid-right);
  }

  /* Only down to 769px: its :not() is more specific than the one-column rules below. */
  @media (min-width: 769px) and (max-width: 1080px) {
    .ds-cgrid:not([data-keep-rails]) {
      grid-template-columns: var(--ds-cgrid-narrow);
    }

    .ds-cgrid:not([data-keep-rails]) > [data-rail="right"] {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .ds-cgrid {
      grid-template-columns: minmax(0, 1fr);
    }

    .ds-cgrid > .ds-cgrid__rail {
      order: 2;
      position: static;
    }

    .ds-cgrid > .ds-cgrid__main {
      order: 1;
    }

    /* As specific as the rules that place the columns, so it wins over them. */
    .ds-cgrid[data-centred] > :is(.ds-cgrid__main, .ds-cgrid__rail) {
      grid-column: auto;
      justify-self: stretch;
      width: auto;
    }

    .ds-cgrid[data-stack-rails="left"] > [data-rail="right"],
    .ds-cgrid[data-stack-rails="right"] > [data-rail="left"],
    .ds-cgrid[data-stack-rails="none"] > .ds-cgrid__rail {
      display: none;
    }
  }
</style>
