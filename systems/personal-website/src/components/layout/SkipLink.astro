---
/**
 * The first thing a keyboard reader reaches on a page: a link past the nav to the main content.
 * It is hidden until it has the focus, then shows at the top left over the nav as a canvas pill
 * with the focus ring. Put it first in the <body>, and give the main content the id it points to.
 *
 * Not in the handoff, which has no skip link; drawn here from its focus ring and canvas pill.
 */
interface Props {
  /** The main content's id, with the #. */
  href?: string;
  label?: string;
}

const { href = "#main", label = "Skip to content" } = Astro.props;
---

<a class="ds-skip-link" href={href}>{label}</a>

<style>
  /* The hairline is an inset shadow over an extra pixel of padding, not a border: Chrome draws a
     visited link's border in a colour of its own, which it does not redraw while the theme fades. */
  .ds-skip-link {
    background: var(--surface-canvas);
    border-radius: var(--radius-full);
    box-shadow: inset 0 0 0 1px var(--hairline);
    color: var(--text-ink);
    font-family: var(--font-sans);
    font-size: var(--nav-link-size);
    font-weight: var(--nav-link-weight);
    left: var(--space-md);
    line-height: var(--nav-link-lh);
    padding: calc(var(--space-xs) + 1px) calc(var(--space-md) + 1px);
    position: fixed;
    text-decoration: none;
    top: var(--space-sm);
    transform: translateY(calc(-100% - var(--space-md)));
    z-index: 60;
  }

  .ds-skip-link:focus {
    box-shadow: inset 0 0 0 1px var(--hairline), 0 0 0 4px var(--focus-ring);
    transform: none;
  }
</style>
