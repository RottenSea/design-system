---
/**
 * The stack of round buttons in the bottom right corner: back to top, plus at most two others,
 * such as the theme or, on a small screen, the table of contents a rail held. Back to top fades
 * in once the reader has scrolled a window's height, and carries --shadow-float. Which screens
 * show the stack is a media query at ContentGrid's breakpoints, so nothing flashes while a script
 * measures the window.
 *
 * Ported from the handoff's FloatingControls.jsx with the same props, except `showTop` and
 * `onTop`: the component watches the scroll itself. Back to top scrolls smoothly unless the
 * reader asked for reduced motion, and then moves the keyboard focus to the top of the page.
 *
 *   <FloatingControls>
 *     <ThemeToggle />
 *   </FloatingControls>
 */
import IconButton from "../buttons/IconButton.astro";

type Device = "mobile" | "tablet" | "desktop";

interface Props {
  /** The screens that show the stack: below 768px, 768 to 1080px, above 1080px. */
  devices?: Device[];
  topLabel?: string;
  tone?: "canvas" | "dark";
  class?: string;
}

const { devices = ["mobile", "tablet", "desktop"], topLabel = "Back to top", tone = "canvas", class: className } = Astro.props;
const shows = (device: Device) => (devices.includes(device) ? "1" : "0");
---

<ds-floating-controls
  class:list={["ds-fc", className]}
  data-mobile={shows("mobile")}
  data-tablet={shows("tablet")}
  data-desktop={shows("desktop")}
>
  <slot />
  <span class="ds-fc__top" data-ds-top>
    <IconButton icon="arrow-up" label={topLabel} tone={tone} class="ds-fc__button" />
  </span>
</ds-floating-controls>

<script>
  class DsFloatingControls extends HTMLElement {
    connectedCallback() {
      const top = this.querySelector<HTMLElement>("[data-ds-top]");
      if (!top) return;
      let frame = 0;
      const update = () => {
        frame = 0;
        top.toggleAttribute("data-shown", window.scrollY > window.innerHeight);
      };
      update();
      window.addEventListener(
        "scroll",
        () => {
          if (!frame) frame = requestAnimationFrame(update);
        },
        { passive: true }
      );
      top.querySelector("button")?.addEventListener("click", () => {
        const reduce =
          matchMedia("(prefers-reduced-motion: reduce)").matches ||
          document.documentElement.dataset.reduceMotion === "true";
        window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
        // Keyboard readers continue from the top, not from a button that has just faded out.
        const start = document.body;
        start.setAttribute("tabindex", "-1");
        start.focus({ preventScroll: true });
        start.addEventListener("blur", () => start.removeAttribute("tabindex"), { once: true });
      });
    }
  }

  if (!customElements.get("ds-floating-controls")) customElements.define("ds-floating-controls", DsFloatingControls);
</script>

<style>
  .ds-fc {
    align-items: flex-end;
    bottom: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    position: fixed;
    right: var(--space-lg);
    z-index: 50;
  }

  .ds-fc > :global(.ds-icon-button),
  .ds-fc__top > :global(.ds-icon-button) {
    box-shadow: var(--shadow-float);
  }

  .ds-fc__top {
    display: inline-flex;
    opacity: 0;
    transition:
      var(--transition-fade),
      visibility var(--motion-base);
    visibility: hidden;
  }

  .ds-fc__top[data-shown] {
    opacity: 1;
    visibility: visible;
  }

  @media (max-width: 768px) {
    .ds-fc[data-mobile="0"] {
      display: none;
    }
  }

  @media (min-width: 769px) and (max-width: 1080px) {
    .ds-fc[data-tablet="0"] {
      display: none;
    }
  }

  @media (min-width: 1081px) {
    .ds-fc[data-desktop="0"] {
      display: none;
    }
  }
</style>
