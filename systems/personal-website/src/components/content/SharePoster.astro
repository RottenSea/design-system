---
/**
 * A 1080 by 1440 poster of a post in the current theme's colours, drawn again on a theme change.
 * The element has `draw()` and `blob()`. The QR code stays dark on a light tile, since not every
 * scanner reads a light code on a dark ground.
 */
interface Props {
  title: string;
  description?: string;
  /** The address the QR code holds. */
  url: string;
  /** The site's name, at the bottom. */
  site: string;
  /** The date as shown, at the bottom. */
  date?: string;
  /** The cover image's URL, on this site. */
  cover?: string;
  /** Waits for draw() instead of drawing at once. */
  lazy?: boolean;
  class?: string;
}

const {
  title,
  description,
  url,
  site,
  date,
  cover,
  lazy = false,
  class: className
} = Astro.props;
---

<ds-share-poster
  class:list={["ds-poster", className]}
  data-poster={JSON.stringify({ title, description, url, site, date, cover })}
  data-lazy={lazy ? "" : undefined}
>
  <canvas width="1080" height="1440" role="img" aria-label={`A poster of “${title}” with a QR code of its address`}
  ></canvas>
</ds-share-poster>

<script>
  import QRCode from "qrcode";
  import { fadeIn, themeStore, themeValues } from "../../scripts/theme";

  interface Poster {
    title: string;
    description?: string;
    url: string;
    site: string;
    date?: string;
    cover?: string;
  }

  const W = 1080;
  const H = 1440;
  const PAD = 96;

  /** The colours and fonts of the theme the poster sits in, and the light theme's for the QR code. */
  function palette(element: HTMLElement) {
    const get = themeValues(element, [
      "--surface-canvas",
      "--surface-card",
      "--text-ink",
      "--text-body",
      "--text-muted",
      "--hairline",
      "--color-primary",
      "--font-display",
      "--font-sans"
    ]);
    const light = themeValues(element, ["--surface-canvas", "--text-ink"], "light");
    return {
      canvas: get["--surface-canvas"],
      card: get["--surface-card"],
      ink: get["--text-ink"],
      body: get["--text-body"],
      muted: get["--text-muted"],
      hairline: get["--hairline"],
      coral: get["--color-primary"],
      serif: get["--font-display"],
      sans: get["--font-sans"],
      qrGround: light["--surface-canvas"],
      qrInk: light["--text-ink"]
    };
  }

  /** Breaks text into lines that fit, between words and between Chinese characters. */
  function lines(ctx: CanvasRenderingContext2D, text: string, width: number, max: number) {
    const words = [...new Intl.Segmenter("zh", { granularity: "word" }).segment(text)].map((part) => part.segment);
    const out: string[] = [];
    let line = "";
    for (const word of words) {
      const next = line + word;
      if (ctx.measureText(next).width <= width || !line) {
        line = next;
        continue;
      }
      out.push(line.trimEnd());
      line = word.trimStart();
    }
    if (line) out.push(line.trimEnd());
    if (out.length <= max) return out;
    const kept = out.slice(0, max);
    let last = kept[max - 1];
    while (last && ctx.measureText(`${last}…`).width > width) last = last.slice(0, -1);
    kept[max - 1] = `${last}…`;
    return kept;
  }

  function loadImage(src: string) {
    return new Promise<HTMLImageElement>((resolve, reject) => {
      const image = new Image();
      image.onload = () => resolve(image);
      image.onerror = reject;
      image.src = src;
    });
  }

  async function draw(canvas: HTMLCanvasElement, poster: Poster, element: HTMLElement) {
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    const c = palette(element);
    const serif = (size: number) => `400 ${size}px ${c.serif}`;
    const sans = (size: number, weight = 400) => `${weight} ${size}px ${c.sans}`;
    // Canvas text uses whatever has loaded; wait for the faces this poster needs.
    await Promise.allSettled([
      document.fonts.load(serif(72), poster.title),
      document.fonts.load(sans(34), `${poster.description ?? ""}${poster.site}`),
      document.fonts.load(sans(30, 500), poster.site)
    ]);

    ctx.fillStyle = c.canvas;
    ctx.fillRect(0, 0, W, H);

    const coverHeight = Math.round((W * 9) / 16);
    ctx.fillStyle = c.card;
    ctx.fillRect(0, 0, W, coverHeight);
    if (poster.cover) {
      try {
        const image = await loadImage(poster.cover);
        const scale = Math.max(W / image.width, coverHeight / image.height);
        const w = image.width * scale;
        const h = image.height * scale;
        ctx.save();
        ctx.beginPath();
        ctx.rect(0, 0, W, coverHeight);
        ctx.clip();
        ctx.drawImage(image, (W - w) / 2, (coverHeight - h) / 2, w, h);
        ctx.restore();
      } catch {
        // A cover that fails to load leaves the cream card.
      }
    }

    let y = coverHeight + PAD;
    ctx.textBaseline = "top";
    ctx.fillStyle = c.ink;
    ctx.font = serif(72);
    for (const line of lines(ctx, poster.title, W - PAD * 2, 3)) {
      ctx.fillText(line, PAD, y);
      y += 90;
    }
    if (poster.description) {
      y += 16;
      ctx.fillStyle = c.body;
      ctx.font = sans(34);
      for (const line of lines(ctx, poster.description, W - PAD * 2, 3)) {
        ctx.fillText(line, PAD, y);
        y += 52;
      }
    }

    const qrSize = 200;
    const footerTop = H - PAD - qrSize;
    ctx.fillStyle = c.hairline;
    ctx.fillRect(PAD, footerTop - 48, W - PAD * 2, 2);
    ctx.fillStyle = c.ink;
    ctx.font = sans(30, 500);
    ctx.fillText(poster.site, PAD, footerTop + 40);
    if (poster.date) {
      ctx.fillStyle = c.muted;
      ctx.font = sans(28);
      ctx.fillText(poster.date, PAD, footerTop + 90);
    }
    ctx.fillStyle = c.coral;
    ctx.fillRect(PAD, footerTop + 150, 48, 4);

    const qr = QRCode.create(poster.url, { errorCorrectionLevel: "M" });
    const size = qr.modules.size;
    const cell = qrSize / size;
    const left = W - PAD - qrSize;
    // A light tile with a quiet zone around the code, in either theme.
    const quiet = 16;
    ctx.fillStyle = c.qrGround;
    ctx.beginPath();
    ctx.roundRect(left - quiet, footerTop - quiet, qrSize + quiet * 2, qrSize + quiet * 2, 12);
    ctx.fill();
    ctx.fillStyle = c.qrInk;
    for (let row = 0; row < size; row++) {
      for (let col = 0; col < size; col++) {
        if (qr.modules.get(row, col)) {
          ctx.fillRect(left + col * cell, footerTop + row * cell, Math.ceil(cell), Math.ceil(cell));
        }
      }
    }
  }

  const toBlob = (canvas: HTMLCanvasElement) =>
    new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, "image/png"));

  class DsSharePoster extends HTMLElement {
    #drawn: Promise<void> | undefined;
    #queue: Promise<void> = Promise.resolve();
    #painted = false;
    #unsubscribe: (() => void) | undefined;

    connectedCallback() {
      if (!this.hasAttribute("data-lazy")) this.draw();
      // A poster already drawn follows the theme, once for each change of it.
      this.#unsubscribe = themeStore().subscribe((state, previous) => {
        if (state.theme === previous.theme || !this.#drawn) return;
        this.#drawn = undefined;
        this.draw();
      });
    }

    disconnectedCallback() {
      this.#unsubscribe?.();
    }

    draw() {
      // Drawings run one after another, so a theme change in the middle of a fade waits for it.
      this.#drawn ??= this.#queue = this.#queue.then(() => this.#paint()).catch(() => undefined);
      return this.#drawn;
    }

    async #paint() {
      const canvas = this.querySelector("canvas");
      if (!canvas) return;
      const poster = JSON.parse(this.dataset.poster ?? "{}") as Poster;
      if (!this.#painted) {
        await draw(canvas, poster, this);
        this.#painted = true;
        return;
      }
      const next = canvas.cloneNode(false) as HTMLCanvasElement;
      await draw(next, poster, this);
      canvas.setAttribute("aria-hidden", "true");
      canvas.after(next);
      await fadeIn(next);
      canvas.remove();
    }

    async blob() {
      await this.draw();
      const canvas = this.querySelector("canvas");
      return canvas ? toBlob(canvas) : null;
    }
  }

  if (!customElements.get("ds-share-poster")) customElements.define("ds-share-poster", DsSharePoster);
</script>

<style>
  /* One cell, so a new drawing can sit over the old one while it fades in. */
  .ds-poster {
    display: grid;
  }

  .ds-poster canvas {
    grid-area: 1 / 1;
    aspect-ratio: 3 / 4;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    display: block;
    height: auto;
    margin: 0 auto;
    max-width: 100%;
    width: 100%;
  }
</style>
