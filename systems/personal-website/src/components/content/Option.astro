---
/**
 * One option of an OptionGroup: its label on the switch and its panel. Use it only directly
 * inside an OptionGroup, which reads the label and value from the marker attributes below and
 * gives the panel its id, its tab and its hidden state.
 *
 * The handoff passes options as an `options` array with a `content` node each. An Astro
 * component cannot take content through a prop, so each option is an element with a slot.
 */
interface Props {
  /** Text on the switch: "pnpm", "macOS". One word where possible. */
  label: string;
  /** What groups sharing a syncKey compare. Defaults to the label. */
  value?: string;
}

const { label, value = label } = Astro.props;
---

<div data-ds-option-label={label} data-ds-option-value={value}>
  <slot />
</div>
