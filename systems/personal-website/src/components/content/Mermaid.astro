---
/**
 * A Mermaid diagram in a DiagramFrame, drawn in the browser over the source the page carries.
 * Mermaid writes colours into the SVG, so each theme gets its own drawing; the other theme's is
 * drawn when the browser is idle and fades in on a theme change.
 */
import DiagramFrame from "./DiagramFrame.astro";

interface Props {
  /** The Mermaid source. */
  code: string;
  /** Uppercase label inside the frame. */
  label?: string;
  caption?: string;
  tone?: "cream" | "dark";
}

const { code, label, caption, tone = "cream" } = Astro.props;
---

<DiagramFrame label={label} caption={caption} tone={tone}>
  <ds-mermaid data-tone={tone}>
    <pre class="ds-diagram__source">{code}</pre>
  </ds-mermaid>
</DiagramFrame>

<script>
  import { fadeIn, themeStore, themeValues, type Theme } from "../../scripts/theme";
  import { fontStylesheets } from "../../styles/fonts.js";
  type Mermaid = (typeof import("mermaid"))["default"];

  let library: Promise<Mermaid> | undefined;
  // Mermaid's settings are global, so diagrams are drawn one after another.
  let queue: Promise<unknown> = Promise.resolve();
  let count = 0;
  let stage: HTMLElement | undefined;

  /** Mermaid measures labels in the container it is given; the body would grow for a moment. */
  function drawingStage() {
    if (!stage?.isConnected) {
      stage = document.createElement("div");
      stage.setAttribute("aria-hidden", "true");
      stage.style.cssText = "position: fixed; inset: 0 auto auto 0; width: 100vw; visibility: hidden; pointer-events: none; overflow: hidden; height: 0;";
      document.body.append(stage);
    }
    return stage;
  }

  /**
   * Fonts loads the sans stylesheet without blocking, and until it arrives document.fonts.ready
   * has no web font to wait for, so labels would be measured in the fallback font.
   */
  const sansSheet = new Promise<void>((resolve) => {
    const link = [...document.querySelectorAll<HTMLLinkElement>('link[rel="stylesheet"]')].find(
      (element) => element.href === fontStylesheets[0]
    );
    if (!link || link.media !== "print") return resolve();
    link.addEventListener("load", () => resolve(), { once: true });
    link.addEventListener("error", () => resolve(), { once: true });
  });

  /** All diagrams on the page wait for the font for one second in total. */
  const patience = new Promise<false>((resolve) => setTimeout(() => resolve(false), 1000));

  const sansFont = (family: string, text: string) =>
    sansSheet.then(() => document.fonts.load(`14px ${family}`, text)).catch(() => undefined);

  const PALETTE = {
    cream: {
      canvas: "--surface-canvas",
      fill: "--surface-card",
      soft: "--surface-soft",
      text: "--text-ink",
      border: "--hairline",
      line: "--text-muted"
    },
    dark: {
      canvas: "--surface-dark",
      fill: "--surface-dark-elevated",
      soft: "--surface-dark-elevated",
      text: "--text-on-dark",
      border: "--hairline-on-dark",
      line: "--text-on-dark-soft"
    }
  };

  /** Every colour is set: Mermaid derives unset ones into colours of its own, even black. */
  const VARIABLES = {
    background: "canvas",
    primaryColor: "fill",
    primaryTextColor: "text",
    primaryBorderColor: "border",
    lineColor: "line",
    tertiaryColor: "soft",
    mainBkg: "fill",
    nodeBorder: "border",
    nodeTextColor: "text",
    textColor: "text",
    titleColor: "text",
    clusterBkg: "soft",
    clusterBorder: "border",
    edgeLabelBackground: "canvas",
    actorBkg: "fill",
    actorBorder: "border",
    actorTextColor: "text",
    actorLineColor: "border",
    signalColor: "line",
    signalTextColor: "text",
    labelBoxBkgColor: "fill",
    labelBoxBorderColor: "border",
    labelTextColor: "text",
    loopTextColor: "text",
    noteBkgColor: "soft",
    noteBorderColor: "border",
    noteTextColor: "text",
    activationBkgColor: "soft",
    activationBorderColor: "border"
  } as const;

  function enqueue<T>(task: () => Promise<T>) {
    const run = queue.then(task);
    queue = run.catch(() => undefined);
    return run;
  }

  const whenIdle = (task: () => void) =>
    "requestIdleCallback" in window ? requestIdleCallback(task, { timeout: 2000 }) : setTimeout(task, 200);

  class DsMermaid extends HTMLElement {
    #code = "";
    #unsubscribe: (() => void) | undefined;
    #inFallback = false;
    #drawings = new Map<Theme, Promise<string | undefined>>();
    /** The theme of the drawing shown last or on its way. */
    #shown: Theme = "light";

    connectedCallback() {
      this.#code = this.querySelector("pre")?.textContent ?? "";
      if (!this.#code.trim()) return;
      void this.#show(document.documentElement.dataset.theme === "dark" ? "dark" : "light", false);
      this.#unsubscribe = themeStore().subscribe((state, previous) => {
        if (state.theme !== previous.theme) void this.#show(state.theme, true);
      });
    }

    disconnectedCallback() {
      this.#unsubscribe?.();
    }

    async #show(theme: Theme, fade: boolean) {
      this.#shown = theme;
      const svg = await this.#drawing(theme);
      // A later change has its own drawing on the way.
      if (!svg || this.#shown !== theme) return;
      whenIdle(() => void this.#drawing(theme === "dark" ? "light" : "dark"));
      await this.#place(svg, fade);
    }

    #drawing(theme: Theme) {
      let drawing = this.#drawings.get(theme);
      if (!drawing) {
        drawing = enqueue(() => this.#render(theme));
        this.#drawings.set(theme, drawing);
      }
      return drawing;
    }

    async #place(svg: string, fade: boolean) {
      if (this.dataset.drawn === undefined) {
        this.innerHTML = svg;
        this.dataset.drawn = "";
        return;
      }
      const old = [...this.children];
      const template = document.createElement("template");
      template.innerHTML = svg;
      for (const element of old) element.setAttribute("aria-hidden", "true");
      this.append(template.content);
      const fresh = this.lastElementChild;
      if (fresh && fade) await fadeIn(fresh);
      for (const element of old) element.remove();
    }

    async #render(theme: Theme) {
      library ??= import("mermaid").then((module) => module.default);
      const mermaid = await library;
      const tone = this.dataset.tone === "dark" ? "dark" : "cream";
      // A frame inside an element with its own data-theme keeps that theme.
      const fixed = this.parentElement?.closest<HTMLElement>("[data-theme]:not(html)")?.dataset.theme;
      const names = [...new Set([...Object.values(PALETTE[tone]), "--font-sans"])];
      const read = themeValues(this, names, fixed === "dark" || fixed === "light" ? fixed : theme);
      // A font later than the second gets both themes drawn again when it comes.
      const font = sansFont(read["--font-sans"], this.#code);
      const inTime = await Promise.race([font.then(() => true), patience]);
      if (!inTime && !this.#inFallback) {
        this.#inFallback = true;
        void font.then(() => {
          this.#drawings.clear();
          void this.#show(this.#shown, true);
        });
      }
      const themeVariables = Object.fromEntries(
        Object.entries(VARIABLES).map(([name, role]) => [name, read[PALETTE[tone][role]]])
      );
      mermaid.initialize({
        startOnLoad: false,
        securityLevel: "strict",
        theme: "base",
        // Mermaid's newer look adds drop shadows and gradient strokes.
        look: "classic",
        themeVariables: { ...themeVariables, fontFamily: read["--font-sans"], fontSize: "14px" }
      });
      try {
        count += 1;
        const { svg } = await mermaid.render(`ds-mermaid-${count}`, this.#code, drawingStage());
        // The half arrowheads of a sequence diagram are black whatever the settings say.
        return svg.replaceAll('stroke="black"', `stroke="${themeVariables.lineColor}"`);
      } catch (error) {
        console.warn("Mermaid could not draw a diagram:", error);
        return undefined;
      }
    }
  }

  if (!customElements.get("ds-mermaid")) customElements.define("ds-mermaid", DsMermaid);
</script>

<style>
  ds-mermaid {
    align-self: stretch;
    display: block;
    max-width: 100%;
  }

  /* One cell, centred, so a new drawing can sit over the old one while it fades in. */
  ds-mermaid[data-drawn] {
    display: grid;
    justify-items: center;
  }

  ds-mermaid[data-drawn] > :global(*) {
    grid-area: 1 / 1;
  }

  ds-mermaid :global(svg) {
    height: auto;
    max-width: 100%;
  }
</style>
