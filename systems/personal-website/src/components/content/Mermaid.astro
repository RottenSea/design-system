---
/**
 * A Mermaid diagram in a DiagramFrame, drawn in the browser. The page carries the diagram's
 * source, shown in the mono face, and mermaid is fetched, as a separate file, only on a page that
 * has a diagram; then the drawing replaces the source. The colours are read from the
 * system's tokens on the element, so the graph matches the page, and because Mermaid writes its
 * colours into the SVG, the diagram is drawn again when the page switches between light and dark;
 * the new drawing fades in over the old one as the page's colours fade.
 *
 * Not in the handoff, which leaves drawing to the page (its DiagramFrame "Mermaid contract"); this
 * follows that contract's way 2 and its token mapping. Coral is not used: nodes stay on the cream
 * and dark surfaces.
 */
import DiagramFrame from "./DiagramFrame.astro";

interface Props {
  /** The Mermaid source. */
  code: string;
  /** Uppercase label inside the frame. */
  label?: string;
  caption?: string;
  tone?: "cream" | "dark";
}

const { code, label, caption, tone = "cream" } = Astro.props;
---

<DiagramFrame label={label} caption={caption} tone={tone}>
  <ds-mermaid data-tone={tone}>
    <pre class="ds-diagram__source">{code}</pre>
  </ds-mermaid>
</DiagramFrame>

<script>
  import { fadeIn, themeStore, themeValues } from "../../scripts/theme";
  import { fontStylesheets } from "../../styles/fonts.js";
  type Mermaid = (typeof import("mermaid"))["default"];

  let library: Promise<Mermaid> | undefined;
  // Mermaid's settings are global, so diagrams are drawn one after another.
  let queue: Promise<unknown> = Promise.resolve();
  let count = 0;
  let stage: HTMLElement | undefined;

  /**
   * Where Mermaid draws before the drawing goes into the frame. Mermaid measures its labels in an
   * element it adds to the container it is given, the body by default, which made the page taller
   * for a moment on every drawing. This one is fixed to the window and hidden, so it takes no room.
   */
  function drawingStage() {
    if (!stage?.isConnected) {
      stage = document.createElement("div");
      stage.setAttribute("aria-hidden", "true");
      stage.style.cssText = "position: fixed; inset: 0 auto auto 0; width: 100vw; visibility: hidden; pointer-events: none; overflow: hidden; height: 0;";
      document.body.append(stage);
    }
    return stage;
  }

  /**
   * The stylesheet with the sans faces, first in the Fonts component's list, once it has loaded.
   * Fonts loads it without holding up the page, and until it arrives the browser knows no web font
   * to wait for, so document.fonts.ready alone let Mermaid measure the labels in the fallback font
   * and then show them in the web font, too wide or too narrow for their boxes.
   */
  const sansSheet = new Promise<void>((resolve) => {
    const link = [...document.querySelectorAll<HTMLLinkElement>('link[rel="stylesheet"]')].find(
      (element) => element.href === fontStylesheets[0]
    );
    if (!link || link.media !== "print") return resolve();
    link.addEventListener("load", () => resolve(), { once: true });
    link.addEventListener("error", () => resolve(), { once: true });
  });

  /** How long the page's diagrams wait for the font, together: a second from when this runs. */
  const patience = new Promise<false>((resolve) => setTimeout(() => resolve(false), 1000));

  /** The sans font in the faces the text needs, once its stylesheet and those files have come. */
  const sansFont = (family: string, text: string) =>
    sansSheet.then(() => document.fonts.load(`14px ${family}`, text)).catch(() => undefined);

  /** The token pairs for each frame tone, as the handoff's contract lists them. */
  const PALETTE = {
    cream: {
      background: "--surface-canvas",
      primaryColor: "--surface-card",
      primaryTextColor: "--text-ink",
      primaryBorderColor: "--hairline",
      lineColor: "--text-muted",
      tertiaryColor: "--surface-soft"
    },
    dark: {
      background: "--surface-dark",
      primaryColor: "--surface-dark-elevated",
      primaryTextColor: "--text-on-dark",
      primaryBorderColor: "--hairline-on-dark",
      lineColor: "--text-on-dark-soft",
      tertiaryColor: "--surface-dark-elevated"
    }
  };

  class DsMermaid extends HTMLElement {
    #code = "";
    #unsubscribe: (() => void) | undefined;
    #inFallback = false;

    connectedCallback() {
      this.#code = this.querySelector("pre")?.textContent ?? "";
      if (!this.#code.trim()) return;
      this.#draw();
      this.#unsubscribe = themeStore().subscribe((state, previous) => {
        if (state.theme !== previous.theme) this.#draw();
      });
    }

    disconnectedCallback() {
      this.#unsubscribe?.();
    }

    #draw() {
      queue = queue.then(() => this.#render()).catch(() => undefined);
    }

    async #render() {
      library ??= import("mermaid").then((module) => module.default);
      const mermaid = await library;
      const tone = this.dataset.tone === "dark" ? "dark" : "cream";
      // The theme's colours as they end, not as they are partway through a theme's fade.
      const read = themeValues(this, [...Object.values(PALETTE[tone]), "--font-sans"]);
      // Mermaid measures its labels, so it waits for the font, for up to a second after the page
      // started. On a slow connection it draws in the fallback font first, and once more when the
      // font has come.
      const font = sansFont(read["--font-sans"], this.#code);
      const inTime = await Promise.race([font.then(() => true), patience]);
      if (!inTime && !this.#inFallback) {
        this.#inFallback = true;
        void font.then(() => this.#draw());
      }
      const themeVariables = Object.fromEntries(
        Object.entries(PALETTE[tone]).map(([name, token]) => [name, read[token]])
      );
      mermaid.initialize({
        startOnLoad: false,
        securityLevel: "strict",
        theme: "base",
        themeVariables: { ...themeVariables, fontFamily: read["--font-sans"], fontSize: "14px" }
      });
      try {
        count += 1;
        const { svg } = await mermaid.render(`ds-mermaid-${count}`, this.#code, drawingStage());
        if (this.dataset.drawn === undefined) {
          this.innerHTML = svg;
          this.dataset.drawn = "";
          return;
        }
        // Drawn again, for a new theme or the web font: the new diagram fades in over the old one,
        // then replaces it.
        const old = [...this.children];
        const template = document.createElement("template");
        template.innerHTML = svg;
        for (const element of old) element.setAttribute("aria-hidden", "true");
        this.append(template.content);
        const fresh = this.lastElementChild;
        if (fresh) await fadeIn(fresh);
        for (const element of old) element.remove();
      } catch (error) {
        // The source stays on the page, which is the frame's fallback.
        console.warn("Mermaid could not draw a diagram:", error);
      }
    }
  }

  if (!customElements.get("ds-mermaid")) customElements.define("ds-mermaid", DsMermaid);
</script>

<style>
  ds-mermaid {
    align-self: stretch;
    display: block;
    max-width: 100%;
  }

  /* One cell, centred, so a new drawing can sit over the old one while it fades in. */
  ds-mermaid[data-drawn] {
    display: grid;
    justify-items: center;
  }

  ds-mermaid[data-drawn] > :global(*) {
    grid-area: 1 / 1;
  }

  ds-mermaid :global(svg) {
    height: auto;
    max-width: 100%;
  }
</style>
