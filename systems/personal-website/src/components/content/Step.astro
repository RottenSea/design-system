---
/**
 * One step inside Steps. The marker is a 28px numbered disc joined to the next step by a 1px
 * hairline; the current step takes the dark surface, the system's selected signal, and a done
 * step takes the coral fill with a check. The number comes from a CSS counter on Steps.
 *
 * The title goes in `title`, or in the `title` slot when it needs links or code. The body is
 * the default slot.
 */
import Check from "../../icons/check.svg";

interface Props {
  title?: string;
  status?: "done" | "current" | "todo";
}

const { title, status = "todo" } = Astro.props;
---

<li class="ds-step" data-status={status} aria-current={status === "current" ? "step" : undefined}>
  <div class="ds-step__marker">
    <span class="ds-step__disc">
      <Check class="ds-step__check" width={16} height={16} aria-hidden="true" />
    </span>
    <span class="ds-step__line" aria-hidden="true"></span>
  </div>
  <div class="ds-step__content">
    <div class="ds-step__title">{title}<slot name="title" /></div>
    {
      Astro.slots.has("default") && (
        <div class="ds-step__body">
          <slot />
        </div>
      )
    }
  </div>
</li>

<style>
  .ds-step {
    align-items: stretch;
    counter-increment: ds-step;
    display: flex;
    gap: var(--space-md);
  }

  .ds-step__marker {
    align-items: center;
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
  }

  .ds-step__disc {
    align-items: center;
    background: var(--surface-card);
    border: 1px solid transparent;
    border-radius: var(--radius-full);
    box-sizing: border-box;
    color: var(--text-muted);
    display: inline-flex;
    font-family: var(--font-sans);
    font-size: var(--caption-size);
    font-variant-numeric: tabular-nums;
    font-weight: 500;
    height: 28px;
    justify-content: center;
    width: 28px;
  }

  .ds-step__disc::before {
    content: counter(ds-step);
  }

  .ds-step__check {
    display: none;
  }

  .ds-step[data-status="done"] .ds-step__disc {
    background: var(--color-primary);
    color: var(--color-on-primary);
  }

  .ds-step[data-status="done"] .ds-step__disc::before {
    content: none;
  }

  .ds-step[data-status="done"] .ds-step__check {
    display: block;
  }

  .ds-step[data-status="current"] .ds-step__disc {
    background: var(--surface-dark);
    color: var(--text-on-dark);
  }

  .ds-step__line {
    background: var(--hairline);
    flex: 1;
    min-height: var(--space-md);
    width: 1px;
  }

  .ds-step:last-child .ds-step__line {
    display: none;
  }

  .ds-step__content {
    font-family: var(--font-sans);
    min-width: 0;
    padding-bottom: var(--space-lg);
  }

  .ds-step:last-child .ds-step__content {
    padding-bottom: 0;
  }

  .ds-step__title {
    color: var(--text-ink);
    font-size: var(--title-sm-size);
    font-weight: var(--title-sm-weight);
    line-height: var(--title-sm-lh);
    padding-top: 3px;
  }

  .ds-step__title > :global(*) {
    margin: 0;
  }

  .ds-step__body {
    color: var(--text-body);
    font-size: var(--body-sm-size);
    line-height: var(--body-sm-lh);
    margin-top: var(--space-xxs);
  }

  .ds-step__body > :global(* + *) {
    margin-top: var(--space-xs);
  }

  /* On the night surface. Steps sets the class; the step reads it from its ancestor. */
  :global(.ds-steps--dark) .ds-step__disc {
    background: var(--surface-dark-elevated);
    color: var(--text-on-dark-soft);
  }

  :global(.ds-steps--dark) .ds-step[data-status="current"] .ds-step__disc {
    background: var(--surface-canvas);
    color: var(--text-ink);
  }

  :global(.ds-steps--dark) .ds-step__line {
    background: var(--hairline-on-dark);
  }

  :global(.ds-steps--dark) .ds-step__title {
    color: var(--text-on-dark);
  }

  :global(.ds-steps--dark) .ds-step__body {
    color: var(--text-on-dark-soft);
  }
</style>
