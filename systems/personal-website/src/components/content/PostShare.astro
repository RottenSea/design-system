---
/**
 * Sharing a post: a row of two buttons, Copy link and Share poster. Copy link puts the post's
 * address on the clipboard and says so in a Snackbar. Share poster opens a Dialog with a poster
 * drawn on a canvas: the cover, or the cream canvas without one, then the title in the display
 * serif, the description, the site's name and the date, and a QR code of the address. The poster
 * downloads as a PNG, and where the browser can share files (most phones), Share hands it to the
 * system's share sheet.
 *
 * The handoff has no share component; this one is made of its Button, Dialog and Snackbar, with
 * SharePoster in the dialog, drawn when the dialog first opens.
 *
 *   <PostShare title="Vibe Coding" description="…" url="https://…/blog/000001" site="The Key of Urala"
 *     date="2026-05-19" cover={coverUrl} filename="vibe-coding" />
 */
import Button from "../buttons/Button.astro";
import Dialog from "../feedback/Dialog.astro";
import Snackbar from "../feedback/Snackbar.astro";
import SharePoster from "./SharePoster.astro";

interface Props {
  title: string;
  description?: string;
  /** The post's full address: what Copy link copies and the QR code holds. */
  url: string;
  /** The site's name, at the bottom of the poster. */
  site: string;
  /** The date as shown, at the bottom of the poster. */
  date?: string;
  /** The cover image's URL, on this site. */
  cover?: string;
  /** The PNG's name, without ".png". */
  filename?: string;
  /** An id for the dialog and the snackbar, unique on the page. */
  id?: string;
  class?: string;
}

const {
  title,
  description,
  url,
  site,
  date,
  cover,
  filename = "poster",
  id = "ds-share",
  class: className
} = Astro.props;
---

<ds-post-share class:list={["ds-share", className]} data-url={url} data-title={title} data-filename={filename}>
  <div class="ds-share__actions">
    <Button variant="secondary" size="sm" iconLeft="link" data-ds-share-copy>Copy link</Button>
    <Button variant="secondary" size="sm" iconLeft="share" data-ds-dialog-open={`${id}-poster`}>Share poster</Button>
  </div>
  <Dialog id={`${id}-poster`} title="Share poster" size="sm">
    <SharePoster title={title} description={description} url={url} site={site} date={date} cover={cover} lazy />
    <Fragment slot="actions">
      <Button variant="secondary" iconLeft="share" data-ds-share-send hidden>Share</Button>
      <Button iconLeft="download" data-ds-share-download>Download</Button>
    </Fragment>
  </Dialog>
  <Snackbar id={`${id}-toast`} />
</ds-post-share>

<script>
  type Poster = HTMLElement & { draw(): Promise<void>; blob(): Promise<Blob | null> };

  class DsPostShare extends HTMLElement {
    connectedCallback() {
      const url = this.dataset.url ?? location.href;
      const title = this.dataset.title ?? document.title;
      const name = `${this.dataset.filename ?? "poster"}.png`;
      const poster = this.querySelector<Poster>("ds-share-poster");
      const dialog = this.querySelector("dialog");
      const toast = this.querySelector<HTMLElement & { show(message: string): void }>("ds-snackbar");
      const send = this.querySelector<HTMLButtonElement>("[data-ds-share-send]");

      this.querySelector("[data-ds-share-copy]")?.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(url);
          toast?.show("Link copied");
        } catch {
          toast?.show("Couldn't copy the link");
        }
      });

      // Draw the poster the first time the dialog opens.
      if (dialog && poster) {
        new MutationObserver(() => {
          if (dialog.open) poster.draw();
        }).observe(dialog, { attributes: true, attributeFilter: ["open"] });
      }

      const file = async () => {
        const blob = await poster?.blob();
        return blob && new File([blob], name, { type: "image/png" });
      };

      this.querySelector("[data-ds-share-download]")?.addEventListener("click", async () => {
        const png = await file();
        if (!png) return;
        const link = document.createElement("a");
        link.href = URL.createObjectURL(png);
        link.download = name;
        link.click();
        setTimeout(() => URL.revokeObjectURL(link.href), 1000);
      });

      const probe = new File([""], name, { type: "image/png" });
      if (send && navigator.canShare?.({ files: [probe] })) {
        send.hidden = false;
        send.addEventListener("click", async () => {
          const png = await file();
          if (!png) return;
          try {
            await navigator.share({ files: [png], title, url });
          } catch {
            // The reader closed the share sheet.
          }
        });
      }
    }
  }

  if (!customElements.get("ds-post-share")) customElements.define("ds-post-share", DsPostShare);
</script>

<style>
  /* In the dialog the poster keeps within the window; a height in vh would track the window. */
  .ds-share :global(.ds-poster canvas) {
    max-height: 56vh;
    width: auto;
  }

  .ds-share__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }


  .ds-share :global([data-ds-share-send][hidden]) {
    display: none;
  }
</style>
