---
/**
 * The long-form callout: note, tip, important, warning, caution, details. A cream card, a 6px
 * status dot and an uppercase micro-label in the semantic colour. The accent lives in the dot
 * and the label only, so several of these down a page never turn it into a paint chart.
 *
 * Ported from the handoff's Admonition.jsx with the same props, except that the foldable
 * `details` variant is a native <details>, which opens and closes, takes the keyboard and
 * reports its state to screen readers without any script. `open` and `defaultOpen` both set
 * whether it starts open; there is no `onToggle` because nothing runs in the browser.
 */
import ChevronDown from "../../icons/chevron-down.svg";

type Variant = "note" | "tip" | "important" | "warning" | "caution" | "details";

interface Props {
  /** Semantic tone. Sets the dot colour and the default label. `details` is foldable. */
  variant?: Variant;
  /** Overrides the label. Sentence case, no trailing period. */
  title?: string;
  /** Whether a `details` callout starts open. */
  open?: boolean;
  defaultOpen?: boolean;
  /** The surface the callout sits on. */
  tone?: "cream" | "dark";
  class?: string;
}

const TITLES: Record<Variant, string> = {
  note: "Note",
  tip: "Tip",
  important: "Important",
  warning: "Warning",
  caution: "Caution",
  details: "Details"
};

const {
  variant = "note",
  title,
  open,
  defaultOpen = false,
  tone = "cream",
  class: className,
  ...rest
} = Astro.props;
const label = title || TITLES[variant] || TITLES.note;
const classes = [
  "ds-admonition",
  `ds-admonition--${variant}`,
  { "ds-admonition--dark": tone === "dark" },
  className
];
---

{
  variant === "details" ? (
    <details class:list={classes} open={open ?? defaultOpen} {...rest}>
      <summary class="ds-admonition__header" data-ds-tap="row">
        <span class="ds-admonition__dot" aria-hidden="true" />
        <span class="ds-admonition__label">{label}</span>
        <ChevronDown class="ds-admonition__chevron" width={18} height={18} aria-hidden="true" />
      </summary>
      <div class="ds-admonition__body ds-reveal-in">
        <slot />
      </div>
    </details>
  ) : (
    <aside class:list={classes} {...rest}>
      <div class="ds-admonition__header">
        <span class="ds-admonition__dot" aria-hidden="true" />
        <span class="ds-admonition__label">{label}</span>
      </div>
      <div class="ds-admonition__body">
        <slot />
      </div>
    </aside>
  )
}

<style>
  .ds-admonition {
    --ds-admonition-accent: var(--accent-teal);
    background: var(--surface-card);
    border-radius: var(--radius-lg);
    box-sizing: border-box;
    margin: var(--space-lg) 0;
    max-width: var(--container-reading);
    padding: var(--space-md);
  }

  .ds-admonition--tip {
    --ds-admonition-accent: var(--status-success);
  }

  .ds-admonition--important {
    --ds-admonition-accent: var(--color-primary);
  }

  .ds-admonition--warning {
    --ds-admonition-accent: var(--status-warning);
  }

  .ds-admonition--caution {
    --ds-admonition-accent: var(--status-error);
  }

  .ds-admonition--details {
    --ds-admonition-accent: var(--text-muted);
  }

  .ds-admonition--dark {
    background: var(--surface-dark-elevated);
  }

  .ds-admonition__header {
    align-items: center;
    display: flex;
    gap: var(--space-xs);
  }

  summary.ds-admonition__header {
    cursor: pointer;
    list-style: none;
  }

  summary.ds-admonition__header::-webkit-details-marker {
    display: none;
  }

  .ds-admonition__dot {
    background: var(--ds-admonition-accent);
    border-radius: var(--radius-full);
    flex: 0 0 auto;
    height: 6px;
    width: 6px;
  }

  .ds-admonition__label {
    color: var(--ds-admonition-accent);
    flex: 1;
    font-family: var(--font-sans);
    font-size: var(--caption-upper-size);
    font-weight: var(--caption-upper-weight);
    letter-spacing: var(--caption-upper-ls);
    line-height: var(--caption-upper-lh);
    min-width: 0;
    text-transform: uppercase;
  }

  .ds-admonition__chevron {
    color: var(--text-muted);
    flex: 0 0 auto;
    transition: transform var(--motion-slow) var(--ease-move);
  }

  .ds-admonition--dark .ds-admonition__chevron {
    color: var(--text-on-dark-soft);
  }

  details[open] .ds-admonition__chevron {
    transform: rotate(180deg);
  }

  .ds-admonition__body {
    color: var(--text-body);
    font-family: var(--font-sans);
    font-size: var(--body-sm-size);
    line-height: var(--body-sm-lh);
    margin-top: var(--space-xs);
  }

  .ds-admonition--dark .ds-admonition__body {
    color: var(--text-on-dark);
  }

  .ds-admonition__body > :global(* + *) {
    margin-top: var(--space-xs);
  }
</style>
