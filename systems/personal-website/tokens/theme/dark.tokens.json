{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Dark theme overrides. Only semantic tokens and shadows change; the palette, the coral primary fill and text on it stay the same in both themes.",
  "color": {
    "$type": "color",
    "primary": {
      "disabled": { "$value": "{color.palette.night.600}" }
    },
    "text": {
      "ink": { "$value": "{color.palette.cream.50}" },
      "body-strong": { "$value": "{color.palette.cream.100}" },
      "body": { "$value": "{color.palette.cream.300}" },
      "muted": { "$value": "{color.palette.ink.300}" },
      "disabled": { "$value": "{color.palette.ink.500}" },
      "link": {
        "$value": "{color.palette.coral.500}",
        "$description": "Inline links. The light theme's coral 800 is too dark on night surfaces, so the dark theme uses coral 500."
      }
    },
    "surface": {
      "canvas": { "$value": "{color.palette.night.900}" },
      "soft": { "$value": "{color.palette.night.850}" },
      "card": { "$value": "{color.palette.night.800}" },
      "strong": { "$value": "{color.palette.night.750}" }
    },
    "border": {
      "default": { "$value": "{color.palette.night.650}" },
      "soft": { "$value": "{color.palette.night.750}" }
    },
    "focus": {
      "$value": "{color.palette.coral.500}",
      "$description": "Keyboard focus outline. Coral 800 drops below 3:1 on night surfaces, so the dark theme uses coral 500."
    },
    "status": {
      "error": {
        "$value": "{color.palette.red.400}",
        "$description": "Error marks and messages. Reads at 4.5:1 on every dark surface."
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "hover": {
      "$value": {
        "color": { "colorSpace": "srgb", "components": [0.0784, 0.0784, 0.0745], "alpha": 0.24, "hex": "#141413" },
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 1, "unit": "px" },
        "blur": { "value": 3, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      },
      "$description": "A card or row under the pointer. Darker than in the light theme so it shows on night surfaces."
    },
    "float": {
      "$value": {
        "color": { "colorSpace": "srgb", "components": [0.0784, 0.0784, 0.0745], "alpha": 0.4, "hex": "#141413" },
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 8, "unit": "px" },
        "blur": { "value": 24, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      },
      "$description": "Menus, popovers and tooltips. Darker than in the light theme so they separate from the page."
    }
  }
}
