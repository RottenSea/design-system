{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Display sizes below 768px. Tracking is rescaled to the smaller sizes; display-sm stays at 28px.",
  "display-xl": {
    "$type": "typography",
    "$value": {
      "fontFamily": "{font.display}",
      "fontSize": {
        "value": 2.75,
        "unit": "rem"
      },
      "fontWeight": 400,
      "lineHeight": 1.05,
      "letterSpacing": {
        "value": -1,
        "unit": "px"
      }
    }
  },
  "display-lg": {
    "$type": "typography",
    "$value": {
      "fontFamily": "{font.display}",
      "fontSize": {
        "value": 2.375,
        "unit": "rem"
      },
      "fontWeight": 400,
      "lineHeight": 1.1,
      "letterSpacing": {
        "value": -0.8,
        "unit": "px"
      }
    }
  },
  "display-md": {
    "$type": "typography",
    "$value": {
      "fontFamily": "{font.display}",
      "fontSize": {
        "value": 2,
        "unit": "rem"
      },
      "fontWeight": 400,
      "lineHeight": 1.15,
      "letterSpacing": {
        "value": -0.4,
        "unit": "px"
      }
    }
  }
}
