{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Type scale. Display uses the serif at weight 400 with negative tracking; everything else uses the sans. Emphasis escalates by size, not weight.",
  "font": {
    "$type": "fontFamily",
    "display": {
      "$value": [
        "Noto Serif SC",
        "Noto Serif CJK SC",
        "Georgia",
        "serif"
      ],
      "$description": "Display headlines, at weight 400 only.",
      "$extensions": {
        "cafe.rottenth": {
          "description": {
            "zh-CN": "大标题，只用 400 字重。"
          }
        }
      }
    },
    "sans": {
      "$value": [
        "Manrope",
        "Noto Sans SC",
        "Source Han Sans SC",
        "system-ui",
        "sans-serif"
      ],
      "$description": "Body, titles, navigation, buttons and labels. Manrope sets Latin text and Noto Sans SC sets Chinese.",
      "$extensions": {
        "cafe.rottenth": {
          "description": {
            "zh-CN": "正文、小标题、导航、按钮和标签。Manrope 显示拉丁字母，Noto Sans SC 显示中文。"
          }
        }
      }
    },
    "mono": {
      "$value": [
        "Maple Mono NL NF CN",
        "ui-monospace",
        "SFMono-Regular",
        "monospace"
      ],
      "$description": "Code, terminal output and technical detail.",
      "$extensions": {
        "cafe.rottenth": {
          "description": {
            "zh-CN": "代码、终端输出和技术细节。"
          }
        }
      }
    },
    "math": {
      "$value": [
        "Noto Sans Math",
        "sans-serif"
      ],
      "$description": "Math formulas.",
      "$extensions": {
        "cafe.rottenth": {
          "description": {
            "zh-CN": "数学公式。"
          }
        }
      }
    }
  },
  "display-xl": {
    "$type": "typography",
    "$value": {
      "fontFamily": "{font.display}",
      "fontSize": {
        "value": 4,
        "unit": "rem"
      },
      "fontWeight": 400,
      "lineHeight": 1.05,
      "letterSpacing": {
        "value": -1.5,
        "unit": "px"
      }
    },
    "$description": "The page headline.",
    "$extensions": {
      "cafe.rottenth": {
        "description": {
          "zh-CN": "页面大标题。"
        }
      }
    }
  },
  "display-lg": {
    "$type": "typography",
    "$value": {
      "fontFamily": "{font.display}",
      "fontSize": {
        "value": 3,
        "unit": "rem"
      },
      "fontWeight": 400,
      "lineHeight": 1.1,
      "letterSpacing": {
        "value": -1,
        "unit": "px"
      }
    },
    "$description": "Section headlines.",
    "$extensions": {
      "cafe.rottenth": {
        "description": {
          "zh-CN": "区块标题。"
        }
      }
    }
  },
  "display-md": {
    "$type": "typography",
    "$value": {
      "fontFamily": "{font.display}",
      "fontSize": {
        "value": 2.25,
        "unit": "rem"
      },
      "fontWeight": 400,
      "lineHeight": 1.15,
      "letterSpacing": {
        "value": -0.5,
        "unit": "px"
      }
    },
    "$description": "Subsection headlines.",
    "$extensions": {
      "cafe.rottenth": {
        "description": {
          "zh-CN": "小节标题。"
        }
      }
    }
  },
  "display-sm": {
    "$type": "typography",
    "$value": {
      "fontFamily": "{font.display}",
      "fontSize": {
        "value": 1.75,
        "unit": "rem"
      },
      "fontWeight": 400,
      "lineHeight": 1.2,
      "letterSpacing": {
        "value": -0.3,
        "unit": "px"
      }
    },
    "$description": "Card headlines and prices.",
    "$extensions": {
      "cafe.rottenth": {
        "description": {
          "zh-CN": "卡片标题和价格。"
        }
      }
    }
  },
  "title-lg": {
    "$type": "typography",
    "$value": {
      "fontFamily": "{font.sans}",
      "fontSize": {
        "value": 1.375,
        "unit": "rem"
      },
      "fontWeight": 500,
      "lineHeight": 1.3,
      "letterSpacing": {
        "value": 0,
        "unit": "px"
      }
    },
    "$description": "Large sans titles.",
    "$extensions": {
      "cafe.rottenth": {
        "description": {
          "zh-CN": "大号无衬线标题。"
        }
      }
    }
  },
  "title-md": {
    "$type": "typography",
    "$value": {
      "fontFamily": "{font.sans}",
      "fontSize": {
        "value": 1.125,
        "unit": "rem"
      },
      "fontWeight": 500,
      "lineHeight": 1.4,
      "letterSpacing": {
        "value": 0,
        "unit": "px"
      }
    },
    "$description": "Card and list titles.",
    "$extensions": {
      "cafe.rottenth": {
        "description": {
          "zh-CN": "卡片和列表标题。"
        }
      }
    }
  },
  "title-sm": {
    "$type": "typography",
    "$value": {
      "fontFamily": "{font.sans}",
      "fontSize": {
        "value": 1,
        "unit": "rem"
      },
      "fontWeight": 500,
      "lineHeight": 1.4,
      "letterSpacing": {
        "value": 0,
        "unit": "px"
      }
    },
    "$description": "Small titles and labels.",
    "$extensions": {
      "cafe.rottenth": {
        "description": {
          "zh-CN": "小标题和标签。"
        }
      }
    }
  },
  "body-md": {
    "$type": "typography",
    "$value": {
      "fontFamily": "{font.sans}",
      "fontSize": {
        "value": 1,
        "unit": "rem"
      },
      "fontWeight": 400,
      "lineHeight": 1.55,
      "letterSpacing": {
        "value": 0,
        "unit": "px"
      }
    },
    "$description": "Running text.",
    "$extensions": {
      "cafe.rottenth": {
        "description": {
          "zh-CN": "正文。"
        }
      }
    }
  },
  "body-sm": {
    "$type": "typography",
    "$value": {
      "fontFamily": "{font.sans}",
      "fontSize": {
        "value": 0.875,
        "unit": "rem"
      },
      "fontWeight": 400,
      "lineHeight": 1.55,
      "letterSpacing": {
        "value": 0,
        "unit": "px"
      }
    },
    "$description": "Secondary text.",
    "$extensions": {
      "cafe.rottenth": {
        "description": {
          "zh-CN": "次要文字。"
        }
      }
    }
  },
  "caption": {
    "$type": "typography",
    "$value": {
      "fontFamily": "{font.sans}",
      "fontSize": {
        "value": 0.8125,
        "unit": "rem"
      },
      "fontWeight": 500,
      "lineHeight": 1.4,
      "letterSpacing": {
        "value": 0,
        "unit": "px"
      }
    },
    "$description": "Captions and metadata.",
    "$extensions": {
      "cafe.rottenth": {
        "description": {
          "zh-CN": "说明文字和元信息。"
        }
      }
    }
  },
  "caption-upper": {
    "$type": "typography",
    "$value": {
      "fontFamily": "{font.sans}",
      "fontSize": {
        "value": 0.75,
        "unit": "rem"
      },
      "fontWeight": 500,
      "lineHeight": 1.4,
      "letterSpacing": {
        "value": 1.5,
        "unit": "px"
      }
    },
    "$description": "Uppercase micro-labels for categories and badges. The only type that is not sentence case.",
    "$extensions": {
      "cafe.rottenth": {
        "description": {
          "zh-CN": "分类和徽章用的大写小标签，系统里唯一不用句首大写的文字。"
        }
      }
    }
  },
  "code": {
    "$type": "typography",
    "$value": {
      "fontFamily": "{font.mono}",
      "fontSize": {
        "value": 0.875,
        "unit": "rem"
      },
      "fontWeight": 400,
      "lineHeight": 1.6,
      "letterSpacing": {
        "value": 0,
        "unit": "px"
      }
    },
    "$description": "Code blocks and inline code.",
    "$extensions": {
      "cafe.rottenth": {
        "description": {
          "zh-CN": "代码块和行内代码。"
        }
      }
    }
  },
  "button": {
    "$type": "typography",
    "$value": {
      "fontFamily": "{font.sans}",
      "fontSize": {
        "value": 0.875,
        "unit": "rem"
      },
      "fontWeight": 500,
      "lineHeight": 1,
      "letterSpacing": {
        "value": 0,
        "unit": "px"
      }
    },
    "$description": "Button labels.",
    "$extensions": {
      "cafe.rottenth": {
        "description": {
          "zh-CN": "按钮文字。"
        }
      }
    }
  },
  "nav-link": {
    "$type": "typography",
    "$value": {
      "fontFamily": "{font.sans}",
      "fontSize": {
        "value": 0.875,
        "unit": "rem"
      },
      "fontWeight": 500,
      "lineHeight": 1.4,
      "letterSpacing": {
        "value": 0,
        "unit": "px"
      }
    },
    "$description": "Navigation links.",
    "$extensions": {
      "cafe.rottenth": {
        "description": {
          "zh-CN": "导航链接。"
        }
      }
    }
  }
}
