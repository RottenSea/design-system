{
  "$schema": "https://www.designtokens.org/schemas/2025.10/resolver.json",
  "name": "personal-website",
  "version": "2025.10",
  "description": "Design tokens for the personal website.",
  "sets": {
    "foundation": {
      "description": "Tokens shared by every theme. The semantic colors and shadows here are the light theme's.",
      "sources": [
        { "$ref": "color/palette.tokens.json" },
        { "$ref": "color/semantic.tokens.json" },
        { "$ref": "typography/font.tokens.json" },
        { "$ref": "typography/styles.tokens.json" },
        { "$ref": "size/space.tokens.json" },
        { "$ref": "size/radius.tokens.json" },
        { "$ref": "effect/shadow.tokens.json" },
        { "$ref": "effect/border.tokens.json" },
        { "$ref": "motion/timing.tokens.json" },
        { "$ref": "motion/transition.tokens.json" }
      ]
    }
  },
  "modifiers": {
    "theme": {
      "description": "Color theme. Light uses the foundation as it is; dark overrides semantic colors and shadows.",
      "contexts": {
        "light": [],
        "dark": [{ "$ref": "theme/dark.tokens.json" }]
      },
      "default": "light"
    }
  },
  "resolutionOrder": [{ "$ref": "#/sets/foundation" }, { "$ref": "#/modifiers/theme" }]
}
