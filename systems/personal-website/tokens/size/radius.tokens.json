{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "radius": {
    "$type": "dimension",
    "$description": "Corner radii in px, so corners stay the same when the reader enlarges text.",
    "xs": { "$value": { "value": 4, "unit": "px" } },
    "sm": { "$value": { "value": 6, "unit": "px" } },
    "md": { "$value": { "value": 8, "unit": "px" } },
    "lg": { "$value": { "value": 12, "unit": "px" } },
    "xl": { "$value": { "value": 16, "unit": "px" } },
    "full": {
      "$value": { "value": 9999, "unit": "px" },
      "$description": "Pills and circles."
    }
  }
}
