{
  "name": "@rottensea/ds-personal-website",
  "version": "0.5.0",
  "private": true,
  "description": "Design system for the personal website.",
  "keywords": [
    "astro-component",
    "design-system"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    "src",
    "assets",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./src/styles/fonts.css",
    "./typography.css": "./src/styles/typography.css",
    "./content.css": "./src/styles/content.css",
    "./motion.css": "./src/styles/motion.css",
    "./touch.css": "./src/styles/touch.css",
    "./base.css": "./src/styles/base.css",
    "./styles.css": "./src/styles/styles.css",
    "./index.css": "./src/styles/index.css",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json",
    "./components": "./src/components/index.ts",
    "./components/*": "./src/components/*",
    "./markdown": {
      "types": "./src/markdown/index.d.ts",
      "default": "./src/markdown/index.js"
    }
  },
  "scripts": {
    "check": "tz check tokens/personal-website.resolver.json",
    "test": "node --test",
    "build": "tz build"
  },
  "peerDependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "astro": "^7.2.0",
    "sharp": "^0.35.4"
  },
  "dependencies": {
    "@shikijs/themes": "4.5.0",
    "@shikijs/transformers": "4.5.0",
    "@unocss/reset": "66.10.5",
    "katex": "0.19.1",
    "mdast-util-to-string": "4.0.0",
    "medium-zoom": "1.1.2",
    "mermaid": "12.2.0",
    "remark-directive": "4.0.0",
    "remark-math": "6.0.0",
    "shiki": "4.5.0",
    "unist-util-visit": "5.2.0"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "7.3.4",
    "@terrazzo/cli": "2.10.0",
    "@terrazzo/plugin-css": "2.10.0",
    "@types/mdast": "4.0.4",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "vfile": "6.0.3"
  }
}
