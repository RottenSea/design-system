---
import { SettingsMenu } from "@rottensea/ds-personal-website/components";
import ExampleLayout from "../../../layouts/ExampleLayout.astro";
---

{/* The theme options show the docs page's choice and are turned off below, so the example cannot
    change the docs page's theme. Reduce motion keeps its choice under a key of its own. */}
<ExampleLayout title="SettingsMenu">
  <div class="row">
    <SettingsMenu storageKey="starlight-theme" motionKey="ds-docs-example-motion" />
    <span class="note">Press the button for the panel. The theme shows the docs page's choice; Reduce motion changes this example only.</span>
  </div>
</ExampleLayout>

<script>
  for (const option of document.querySelectorAll<HTMLButtonElement>(".ds-settings__theme button[data-value]")) {
    option.disabled = true;
  }
</script>

<style>
  /* Tall enough for the open panel, which floats under the button and is not part of the
     example's height. */
  .row {
    align-items: flex-start;
    display: flex;
    gap: var(--space-md);
    min-height: 16rem;
  }

  .note {
    color: var(--text-muted);
    font-size: var(--body-sm-size);
    padding-top: var(--space-xs);
  }
</style>
