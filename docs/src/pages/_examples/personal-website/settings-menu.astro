---
import { SettingsMenu } from "@rottensea/ds-personal-website/components";
import ExampleLayout from "../../../layouts/ExampleLayout.astro";
---

{/* The example keeps its choice under a key of its own, so the docs site keeps its theme. */}
<ExampleLayout title="SettingsMenu" themeKey="ds-docs-example-theme">
  <div class="row">
    <SettingsMenu storageKey="ds-docs-example-theme" motionKey="ds-docs-example-motion" />
    <span class="note">Press the button for the panel. A choice changes this example only.</span>
  </div>
</ExampleLayout>

<style>
  /* Tall enough for the open panel, which floats under the button and is not part of the
     example's height. */
  .row {
    align-items: flex-start;
    display: flex;
    gap: var(--space-md);
    min-height: 16rem;
  }

  .note {
    color: var(--text-muted);
    font-size: var(--body-sm-size);
    padding-top: var(--space-xs);
  }
</style>
