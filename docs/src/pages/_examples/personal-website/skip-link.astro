---
// SkipLink stays hidden until it has the keyboard focus, so the example only says how to reach it.
import ExampleLayout from "../../../layouts/ExampleLayout.astro";
---

<ExampleLayout title="SkipLink">
  <p class="hint">
    On a page of the site, press Tab right after it loads: “Skip to content” shows at the top left.
    Press Enter to jump past the nav to the main content.
  </p>
</ExampleLayout>

<style>
  .hint {
    color: var(--text-muted);
    font-size: var(--body-sm-size);
    margin: 0;
  }
</style>
