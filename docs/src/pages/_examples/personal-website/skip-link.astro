---
// SkipLink alone: the space is empty until the link takes the focus, which is how it looks on a
// page. Click the space, press Tab, and the link shows at the top left.
import { SkipLink } from "@rottensea/ds-personal-website/components";
import ExampleLayout from "../../../layouts/ExampleLayout.astro";
---

<ExampleLayout title="SkipLink">
  <SkipLink href="#content" />
  <div class="space"></div>
  <div id="content" tabindex="-1"></div>
</ExampleLayout>

<style>
  /* Room for the link, which shows at the top left. */
  .space {
    height: 4rem;
  }
</style>
