---
// Dialog as the site uses it: the share poster's, small, opened from a button at the end of a post,
// with Download as its action. The poster itself is SharePoster, on the PostShare page.
import { Button, Dialog } from "@rottensea/ds-personal-website/components";
import ExampleLayout from "../../../layouts/ExampleLayout.astro";
---

<ExampleLayout title="Dialog">
  <Button variant="secondary" size="sm" iconLeft="share" data-ds-dialog-open="example-dialog">Share poster</Button>
  <Dialog id="example-dialog" title="Share poster" size="sm">
    <p class="body">A poster of the post goes here: its cover, title and description, and a QR code of its address.</p>
    <Fragment slot="actions">
      <Button iconLeft="download" data-example-close>Download</Button>
    </Fragment>
  </Dialog>
</ExampleLayout>

<script>
  // The example's Download only closes the dialog, the way its close button does; the site saves
  // the poster first.
  document.querySelector("[data-example-close]")?.addEventListener("click", () => {
    document.querySelector<HTMLElement>("#example-dialog [data-ds-dialog-close]")?.click();
  });
</script>

<style>
  .body {
    color: var(--text-body);
    font-size: var(--body-md-size);
    line-height: var(--body-md-lh);
    margin: 0;
  }
</style>
