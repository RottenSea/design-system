---
import { CodeBlock } from "@rottensea/ds-personal-website/components";
import ExampleLayout from "../../../layouts/ExampleLayout.astro";

const css = `.ds-reveal-in {
  animation: ds-reveal-in var(--motion-base) var(--ease-enter) both;
}

@keyframes ds-reveal-in {
  from { opacity: 0; transform: translateY(4px); }
}`;

const diff = `export default defineConfig({
  site: "https://article.rottenth.cafe",
  build: { format: "directory" }, // [!code --]
  build: { format: "file" }, // [!code ++]
  trailingSlash: "never"
});`;

const wide = `# Build the post site, then deploy it to Cloudflare with its own Wrangler config
pnpm --filter article exec astro build --site https://article.rottenth.cafe && npx wrangler deploy --config sites/article/wrangler.jsonc --keep-vars`;

const tall = `import mdx from "@astrojs/mdx";
import sitemap from "@astrojs/sitemap";
import { defineConfig } from "astro/config";
import {
  markdown,
  rehypeDsExternalLinks,
  rehypeDsHeadingAnchors,
  shikiTransformers
} from "@rottensea/ds-personal-website/markdown";

export default defineConfig({
  site: "https://article.rottenth.cafe",
  trailingSlash: "never",
  build: { format: "file" },
  integrations: [mdx(), sitemap()],
  markdown: {
    remarkPlugins: [markdown],
    rehypePlugins: [rehypeDsHeadingAnchors, rehypeDsExternalLinks],
    shikiConfig: {
      themes: { light: "github-light", dark: "github-dark" },
      transformers: shikiTransformers()
    }
  }
});`;
---

<ExampleLayout title="CodeBlock">
  <CodeBlock code={css} lang="css" filename="src/styles/motion.css" highlightLines={[2]} />
  <CodeBlock code={diff} lang="ts" filename="astro.config.ts" />
  <CodeBlock code="pnpm add astro" lang="sh" />
  <CodeBlock code={wide} lang="sh" />
  <CodeBlock code={tall} lang="ts" filename="astro.config.ts" />
</ExampleLayout>
