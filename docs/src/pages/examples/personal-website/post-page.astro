---
// A post as the personal website builds it: one reading column, 680px at most, centred in the
// grid with the table of contents in the right rail, which stays beside it at any width the rail
// fits; there is no left rail. The meta line and title, the cover, the text, then the end matter:
// tags, licence, share and the neighbouring posts.
import {
  ContentGrid,
  Figure,
  FloatingControls,
  Footer,
  IconButton,
  PostLicense,
  PostMeta,
  PostNav,
  PostShare,
  SettingsMenu,
  SidebarCard,
  SkipLink,
  Starfield,
  TagList,
  TocButton,
  TocList,
  TopNav
} from "@rottensea/ds-personal-website/components";
import cover from "../../../assets/examples/tower.jpg";
import ExampleLayout from "../../../layouts/ExampleLayout.astro";

// A made-up site, so the example shows the parts and not a real one's content.
const links = [
  { label: "Blog", href: "#main" },
  { label: "About", href: "#main" }
];
const columns = [
  { title: "Site", links: [...links, { label: "RSS", href: "#main" }] },
  { title: "Elsewhere", links: [{ label: "GitHub", href: "https://github.com/" }] }
];
const sections = [
  { id: "one-hex", text: "One hex, two jobs", level: 2 },
  { id: "inside-a-band", text: "Inside a band", level: 3 },
  { id: "where-it-goes-wrong", text: "Where it goes wrong", level: 2 },
  { id: "the-pacing-rule", text: "The pacing rule", level: 2 },
  { id: "what-to-do-instead", text: "What to do instead", level: 2 }
];
const title = "Hairlines carry more than they look like they do";
---

{/* The settings panel keeps its choice in the example, not on the docs site. */}
<ExampleLayout title="Post page" bare themeKey="ds-docs-example-theme">
  <Starfield />
  <SkipLink />
  <TopNav brand="Field Notes" brandHref="#" links={links} active="Blog">
    <IconButton slot="actions" icon="search" label="Search" />
    <SettingsMenu slot="actions" storageKey="ds-docs-example-theme" motionKey="ds-docs-example-motion" />
  </TopNav>
  <main id="main" class="page">
    <ContentGrid stackRails="none" mainWidth="var(--container-reading)">
      <article class="post">
        <header class="post__header">
          <PostMeta
            size="md"
            items={[
              { label: "2026-03-04", datetime: "2026-03-04T03:00:00Z" },
              { label: "Notes", href: "#main" },
              "6 min"
            ]}
          />
          <h1 class="post__title">{title}</h1>
        </header>
        <Figure src={cover} alt="" zoom={false} class="post__cover" />
        <div class="prose">
          {
            sections.map((section) => {
              const Heading = section.level === 2 ? "h2" : "h3";
              return (
                <>
                  <Heading id={section.id}>{section.text}</Heading>
                  <p>
                    A border at one pixel is an elevation step, not an ink line. Where the two get confused, a page
                    starts to look wired together instead of built: every element outlined, nothing grouped.
                  </p>
                  <p>
                    Reach for a surface change before a line, and for a line before a shadow. A page built that way
                    stays quiet at small sizes, which is where most reading happens.
                  </p>
                </>
              );
            })
          }
        </div>
        <footer class="post__end">
          <TagList items={[{ label: "type", href: "#main" }, { label: "systems", href: "#main" }]} />
          <PostLicense
            title={title}
            href="https://example.com/blog/hairlines"
            author="Field Notes"
            published={{ label: "2026-03-04", datetime: "2026-03-04T03:00:00Z" }}
            license={{ name: "CC BY-NC-SA 4.0", href: "https://creativecommons.org/licenses/by-nc-sa/4.0/" }}
          />
          <PostShare
            title={title}
            description="A one-pixel line in the right colour separates two things without drawing attention to itself."
            url="https://example.com/blog/hairlines"
            site="Field Notes"
            date="2026-03-04"
            filename="hairlines"
          />
          <PostNav
            prev={{ title: "Notes on reading less, slower", href: "#main" }}
            next={{ title: "Writing for a page nobody scrolls twice", href: "#main" }}
          />
        </footer>
      </article>
      <Fragment slot="right">
        <SidebarCard title="On this page">
          <TocList items={sections} maxHeight="calc(100vh - 12rem)" />
        </SidebarCard>
      </Fragment>
    </ContentGrid>
  </main>
  <Footer brand="Field Notes" columns={columns} note="© 2026 Field Notes." />
  <FloatingControls>
    <TocButton items={sections} />
  </FloatingControls>
</ExampleLayout>

<style>
  /* The example's <html> has the canvas colour, so <body> drops its own, which would cover the
     sky; on the site <body>'s colour goes to the whole window instead. */
  :global(body) {
    background: transparent;
  }

  /* The site's main: the grid's full width, with the site's padding. */
  .page {
    padding: var(--space-xl) var(--space-lg) var(--space-section);
    width: 100%;
  }

  .post {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    max-width: var(--container-reading);
    min-width: 0;
  }

  .post__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .post__title {
    color: var(--text-ink);
    font-family: var(--display-lg-family);
    font-size: var(--display-lg-size);
    font-weight: var(--display-lg-weight);
    letter-spacing: var(--display-lg-ls);
    line-height: var(--display-lg-lh);
    text-wrap: pretty;
  }

  /* The cover is the top of the post, so it has no caption gap under it. */
  .post :global(.post__cover) {
    margin: 0;
  }

  .post__end {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    margin-top: var(--space-xl);
  }

  /* The site's prose styles, which the system leaves to the site. */
  .prose > :global(* + *) {
    margin-top: var(--space-md);
  }

  .prose h2 {
    font-family: var(--display-sm-family);
    font-size: var(--display-sm-size);
    font-weight: var(--display-sm-weight);
    letter-spacing: var(--display-sm-ls);
    line-height: var(--display-sm-lh);
  }

  .prose > h2 {
    margin-top: var(--space-xxl);
  }

  .prose h3 {
    font-family: var(--title-lg-family);
    font-size: var(--title-lg-size);
    font-weight: var(--title-lg-weight);
    letter-spacing: var(--title-lg-ls);
    line-height: var(--title-lg-lh);
  }

  .prose > h3 {
    margin-top: var(--space-xl);
  }

  @media (max-width: 768px) {
    .post__title {
      font-size: var(--display-md-size);
      letter-spacing: var(--display-md-ls);
      line-height: var(--display-md-lh);
    }
  }
</style>
