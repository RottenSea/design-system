---
import Logo from "@rottensea/ds-personal-website/assets/logo-colored.svg";
import {
  IconButton,
  SettingsMenu,
  TopNav
} from "@rottensea/ds-personal-website/components";
import ExampleLayout from "../../../layouts/ExampleLayout.astro";

const links = [
  { label: "Blog", href: "#" },
  { label: "About", href: "#" }
];
---

<ExampleLayout title="TopNav" bare>
  {/* As the site has it: Blog and About, then search and the display settings. */}
  <TopNav brand="Field Notes" brandHref="#" links={links} active="Blog">
    <Logo slot="logo" width={24} height={24} aria-hidden="true" />
    <IconButton slot="actions" icon="search" label="Search" />
    <SettingsMenu slot="actions" storageKey="ds-docs-example-theme" motionKey="ds-docs-example-motion" />
  </TopNav>
  <p class="hint">Make the window narrower than 768px and the links become a menu button, with the mark alone at the left.</p>
</ExampleLayout>

<style>
  .hint {
    color: var(--text-muted);
    font-size: var(--body-sm-size);
    margin: 0;
    padding: var(--space-md) var(--space-lg) var(--space-lg);
  }
</style>
