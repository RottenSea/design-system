---
// As the home page has it: bare over the sky, in the theme's ink, as tall as the window, one of
// several quotes at random.
import { QuoteBand, Starfield } from "@rottensea/ds-personal-website/components";
import ExampleLayout from "../../../layouts/ExampleLayout.astro";

const long =
  "The second draft is where the piece finds out what it was about, and most of the work is cutting what the first draft needed in order to get there.";
---

<ExampleLayout title="QuoteBand" bare>
  <Starfield />
  <QuoteBand
    tone="bare"
    overlayTone="ink"
    eyebrow="Writing since 2019"
    quotes={[
      { text: "Make the small decisions once, then stop deciding." },
      { text: long, attribution: "A longer quote steps down a size" }
    ]}
  />
</ExampleLayout>

<style>
  /* The example's <html> has the canvas colour, so <body> drops its own, which would cover the
     sky; on the site <body>'s colour goes to the whole window instead. */
  :global(body) {
    background: transparent;
  }
</style>
