---
import { IconButton } from "@rottensea/ds-personal-website/components";
import ExampleLayout from "../../../layouts/ExampleLayout.astro";
---

<ExampleLayout title="FloatingControls">
  {/* As a post has them: back to top, and the table of contents on a narrow screen. */}
  <div class="row">
    <IconButton icon="arrow-up" label="Back to top" class="float" />
    <IconButton icon="list" label="On this page" class="float" />
  </div>
</ExampleLayout>

<style>
  .row {
    align-items: center;
    display: flex;
    gap: var(--space-sm);
    padding: var(--space-sm);
  }


  .row > :global(.float) {
    box-shadow: var(--shadow-float);
  }
</style>
