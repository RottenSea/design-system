---
// Button as the site uses it: in the share dialog, Download and Share; at the end of a post,
// the two small secondary buttons.
import { Button } from "@rottensea/ds-personal-website/components";
import ExampleLayout from "../../../layouts/ExampleLayout.astro";
---

<ExampleLayout title="Button">
  <div class="row">
    <Button variant="secondary" size="sm" iconLeft="link">Copy link</Button>
    <Button variant="secondary" size="sm" iconLeft="share">Share poster</Button>
  </div>
  <div class="row">
    <Button variant="secondary" iconLeft="share">Share</Button>
    <Button iconLeft="download">Download</Button>
  </div>
</ExampleLayout>

<style>
  .row {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }
</style>
