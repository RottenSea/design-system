---
import { ThemeToggle } from "@rottensea/ds-personal-website/components";
import ExampleLayout from "../../../layouts/ExampleLayout.astro";
---

<ExampleLayout title="ThemeToggle">
  <div class="row">
    <ThemeToggle storageKey="ds-docs-example-theme" />
    <p class="text">It shows the icon for the other theme. Switch this example with the link below it.</p>
  </div>
</ExampleLayout>

<script>
  // Pressing the toggle here would change the docs site's theme too, so the press stops before
  // the toggle hears it; the theme changes only from outside the example.
  document.querySelector(".row")?.addEventListener(
    "click",
    (event) => {
      if ((event.target as Element).closest(".ds-theme-toggle")) event.stopPropagation();
    },
    { capture: true }
  );
</script>

<style>
  .row {
    align-items: center;
    display: flex;
    gap: var(--space-md);
  }

  .text {
    font-size: var(--body-sm-size);
    margin: 0;
  }
</style>
