---
// The wordmark: the coloured mark and the name in the sans at 500, on the canvas of the current
// theme; the link under the example shows the other. The mark is never inverted.
import Logo from "@rottensea/ds-personal-website/assets/logo-colored.svg";
import ExampleLayout from "../../../layouts/ExampleLayout.astro";
---

<ExampleLayout title="Wordmark">
  <div class="mark">
    <Logo width={26} height={26} aria-hidden="true" />
    <span class="name">The Key of Urala</span>
  </div>
</ExampleLayout>

<style>
  .mark {
    align-items: center;
    background: var(--surface-canvas);
    border: var(--border-hairline);
    border-radius: var(--radius-lg);
    display: flex;
    gap: var(--space-xs);
    padding: var(--space-lg);
  }

  .name {
    color: var(--text-ink);
    font-family: var(--font-sans);
    font-size: var(--title-sm-size);
    font-weight: 500;
  }
</style>
