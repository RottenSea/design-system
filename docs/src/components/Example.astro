---
/**
 * Shows a component example page in an iframe, so the example uses only the system's CSS. The
 * example page (ExampleLayout) follows the docs site's theme through its own theme store, and
 * makes the iframe as tall as its content. The browser tells the example of a change in
 * localStorage only a moment later, so this page tells it at once, and both fade together.
 *
 *   <Example system="personal-website" name="admonition" title="Admonition variants" />
 *
 * loads src/pages/examples/personal-website/admonition.astro.
 *
 * The iframe is as wide as the article column, under 768px, so a page layout would always show
 * its narrowest form. `viewport` lays the example out at that width instead and scales it down
 * to fit the column, with a link to open it at full size. `height` gives a whole-page example a
 * fixed window height, at that width, to scroll inside, instead of growing to its content.
 */
interface Props {
  system: string;
  name: string;
  /** The iframe's accessible name. */
  title: string;
  /** The width, in px, to lay the example out at before scaling it to the column. */
  viewport?: number;
  /** The window height, in px, for an example that scrolls inside the iframe. */
  height?: number;
}

const { system, name, title, viewport, height } = Astro.props;
const src = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/examples/${system}/${name}/`;
const zh = Astro.locals.starlightRoute?.lang === "zh-CN";
---

<ds-example data-viewport={viewport}>
  <div class:list={["stage", { "stage--scaled": viewport }]}>
    <iframe
      src={src}
      title={title}
      loading="lazy"
      data-height={height}
      style={[viewport && `width: ${viewport}px`, height && `height: ${height}px`].filter(Boolean).join("; ") || undefined}
    ></iframe>
  </div>
  {
    viewport && (
      <a class="full" href={src} target="_blank" rel="noreferrer">
        {zh ? `按 ${viewport}px 宽打开` : `Open at ${viewport}px`}
        <span aria-hidden="true"> ↗</span>
      </a>
    )
  }
</ds-example>

<script>
  import { themeStore } from "@rottensea/ds-personal-website/scripts/theme";

  class DsExample extends HTMLElement {
    connectedCallback() {
      const frame = this.querySelector("iframe");
      const stage = this.querySelector<HTMLElement>(".stage");
      if (!frame || !stage) return;
      // The store has already written the choice; the example's store reads it on a storage event.
      // The browser's own event follows and finds nothing new.
      const store = themeStore("starlight-theme");
      store.subscribe(() => {
        const view = frame.contentWindow as (Window & typeof globalThis) | null;
        view?.dispatchEvent(new view.StorageEvent("storage", { key: store.key }));
      });
      const viewport = Number(this.dataset.viewport);
      if (!viewport) return;
      // The example page sets the iframe's height; the stage shrinks with the scale around it.
      const scale = () => {
        const factor = Math.min(1, stage.clientWidth / viewport);
        frame.style.transform = `scale(${factor})`;
        stage.style.height = `${frame.offsetHeight * factor}px`;
      };
      scale();
      const observer = new ResizeObserver(scale);
      observer.observe(stage);
      observer.observe(frame);
    }
  }

  if (!customElements.get("ds-example")) customElements.define("ds-example", DsExample);
</script>

<style>
  ds-example {
    display: block;
    margin-block: 1.5rem;
  }

  .stage {
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    overflow: hidden;
  }

  iframe {
    border: 0;
    display: block;
    height: 12rem;
    width: 100%;
  }

  /* Starlight caps media in an article at 100% of the column; a scaled example is laid out wider. */
  .stage--scaled iframe {
    max-width: none;
    transform-origin: top left;
  }

  .full {
    display: inline-block;
    font-size: var(--sl-text-sm);
    margin-top: 0.5rem;
  }
</style>
