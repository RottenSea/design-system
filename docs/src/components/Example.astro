---
/**
 * Shows a component example page in an iframe, so the example uses only the system's CSS. The
 * iframe follows the docs page's light or dark theme; the example page itself (ExampleLayout)
 * makes the iframe as tall as its content.
 *
 *   <Example system="personal-website" name="admonition" title="Admonition variants" />
 *
 * loads src/pages/examples/personal-website/admonition.astro.
 */
interface Props {
  system: string;
  name: string;
  /** The iframe's accessible name. */
  title: string;
}

const { system, name, title } = Astro.props;
const src = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/examples/${system}/${name}/`;
---

<ds-example>
  <iframe src={src} title={title} loading="lazy"></iframe>
</ds-example>

<script>
  class DsExample extends HTMLElement {
    connectedCallback() {
      const frame = this.querySelector("iframe");
      if (!frame) return;
      const syncTheme = () => {
        const root = frame.contentDocument?.documentElement;
        if (root) root.dataset.theme = document.documentElement.dataset.theme === "dark" ? "dark" : "light";
      };

      new MutationObserver(syncTheme).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"]
      });
    }
  }

  if (!customElements.get("ds-example")) customElements.define("ds-example", DsExample);
</script>

<style>
  ds-example {
    display: block;
    margin-block: 1.5rem;
  }

  iframe {
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    display: block;
    height: 12rem;
    width: 100%;
  }
</style>
