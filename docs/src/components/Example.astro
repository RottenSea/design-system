---
/**
 * Shows a component example page in an iframe, so the example uses only the system's CSS. The
 * iframe follows the docs page's light or dark theme and grows or shrinks to its content.
 *
 *   <Example system="personal-website" name="admonition" title="Admonition variants" />
 *
 * loads src/pages/examples/personal-website/admonition.astro.
 */
interface Props {
  system: string;
  name: string;
  /** The iframe's accessible name. */
  title: string;
}

const { system, name, title } = Astro.props;
const src = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/examples/${system}/${name}/`;
---

<ds-example>
  <iframe src={src} title={title} loading="lazy"></iframe>
</ds-example>

<script>
  class DsExample extends HTMLElement {
    connectedCallback() {
      const frame = this.querySelector("iframe");
      if (!frame) return;
      let fit = () => {};

      const syncTheme = () => {
        const root = frame.contentDocument?.documentElement;
        if (root) root.dataset.theme = document.documentElement.dataset.theme === "dark" ? "dark" : "light";
        fit();
      };

      const setUp = () => {
        const doc = frame.contentDocument;
        const win = frame.contentWindow as (Window & typeof globalThis) | null;
        if (!doc || !win || doc.URL === "about:blank") return;
        // The <html> element's own height is the content height; scrollHeight never reports
        // less than the iframe, so it could only grow. The iframe's borders are added on top.
        fit = () => {
          const borders = frame.offsetHeight - frame.clientHeight;
          frame.style.height = `${Math.ceil(doc.documentElement.getBoundingClientRect().height) + borders}px`;
        };
        syncTheme();
        doc.fonts.ready.then(() => fit());
        new win.ResizeObserver(() => fit()).observe(doc.documentElement);
      };

      frame.addEventListener("load", setUp);
      if (frame.contentDocument?.readyState === "complete") setUp();
      new MutationObserver(syncTheme).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"]
      });
    }
  }

  if (!customElements.get("ds-example")) customElements.define("ds-example", DsExample);
</script>

<style>
  ds-example {
    display: block;
    margin-block: 1.5rem;
  }

  iframe {
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    display: block;
    height: 12rem;
    width: 100%;
  }
</style>
