---
/**
 * A bare page for one component example, loaded in an iframe by the Example component. It loads
 * only the system's own CSS, so Starlight's styles and the example never touch each other.
 */
import { Fonts } from "@rottensea/ds-personal-website/components";
import "@rottensea/ds-personal-website/index.css";

interface Props {
  title: string;
  /** Drops the padding, for an example that is a whole page. */
  bare?: boolean;
  /**
   * Where the example's theme store keeps a choice made inside the example. By default it is
   * Starlight's key, so the example follows the docs site; an example whose own controls choose a
   * theme passes a key of its own, so a choice there changes that example only.
   */
  themeKey?: string;
}

const { title, bare = false, themeKey = "starlight-theme" } = Astro.props;
// A whole-page example has its own <main>.
const Wrapper = bare ? "div" : "main";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <Fonts />
    {/*
      Takes the docs page's theme before the first paint. The docs page and the example share an
      origin, so the parent's data-theme can be read directly. Later changes come through the theme
      store below, under Starlight's key.

      It also sizes the iframe to the content from here, starting while the page is still being
      parsed, instead of waiting for the load event, which in development comes only after every
      module, font and image has arrived. The <html> element's own height is the content height;
      scrollHeight never reports less than the iframe, so it could only grow. The iframe's
      borders are added on top. With the iframe always as tall as the content, the page never
      needs a vertical scrollbar, so it has none, and none flashes while the height catches up.
    */}
    <script is:inline define:vars={{ themeKey }}>
      const root = document.documentElement;
      root.dataset.themeKey = themeKey;
      // The example can be shown in the other theme for a while (see dsExample below).
      root.dataset.themePinned = "";
      if (window.parent !== window) {
        try {
          root.dataset.theme = window.parent.document.documentElement.dataset.theme === "dark" ? "dark" : "light";
        } catch {
          root.dataset.theme = "light";
        }
      } else {
        // Opened on its own ("Open at 1280px"): the theme the example showed on the docs page, or
        // the one picked on the docs site, which Starlight keeps in localStorage, or else the OS.
        let picked = new URLSearchParams(location.search).get("theme") ?? "";
        if (picked !== "light" && picked !== "dark") {
          try {
            picked = localStorage.getItem("starlight-theme") ?? "";
          } catch {}
        }
        root.dataset.theme =
          picked === "light" || picked === "dark"
            ? picked
            : matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
      }
      // The iframe element belongs to the docs page, so instanceof against this page's classes fails.
      const frame = window.frameElement;
      // A whole-page example has a fixed window height from Example's `height` and scrolls
      // inside it, as a page does in a browser window: a full-height band such as QuoteBand would
      // otherwise grow with the iframe it sizes, and the iframe with it.
      const fixed = frame ? Number(frame.getAttribute("data-height")) : 0;
      if (frame && fixed) {
        frame.style.height = `${fixed}px`;
      } else if (frame) {
        root.style.overflowY = "hidden";
        const fit = () => {
          const borders = frame.offsetHeight - frame.clientHeight;
          frame.style.height = `${Math.ceil(root.getBoundingClientRect().height) + borders}px`;
        };
        new ResizeObserver(fit).observe(root);
        document.addEventListener("DOMContentLoaded", fit);
        document.fonts.ready.then(fit);
      }
    </script>
  </head>
  <body>
    <Wrapper class:list={["example", { "example--bare": bare }]}>
      <slot />
    </Wrapper>
    {/* Shown only when the example is opened on its own, with no docs page around it. */}
    <button class="example-theme" type="button" hidden>Switch theme</button>
  </body>
</html>

<script>
  import { themeStore } from "@rottensea/ds-personal-website/scripts/theme";

  // The example follows the docs site, in a frame or on its own: a choice made there arrives as a
  // storage event under Starlight's key, and the OS is followed while the choice is Auto.
  themeStore();

  // Shows the example in a theme of its own until the docs site's theme next changes. It writes
  // data-theme without the store, which would save the choice under Starlight's key and so change
  // the docs site too; the store sees the change and tells the components, which fade as usual.
  const root = document.documentElement;
  const dsExample = {
    theme: (): "light" | "dark" => (root.dataset.theme === "dark" ? "dark" : "light"),
    show(theme: "light" | "dark") {
      root.dataset.theme = theme;
    }
  };
  Object.assign(window, { dsExample });

  if (window.parent === window) {
    const button = document.querySelector<HTMLButtonElement>(".example-theme");
    if (button) {
      const label = () => {
        button.textContent = dsExample.theme() === "dark" ? "Light theme" : "Dark theme";
      };
      label();
      button.hidden = false;
      button.addEventListener("click", () => {
        dsExample.show(dsExample.theme() === "dark" ? "light" : "dark");
        label();
      });
      new MutationObserver(label).observe(root, { attributes: true, attributeFilter: ["data-theme"] });
    }
  }
</script>

<style>
  .example {
    padding: var(--space-lg);
  }

  .example--bare {
    padding: 0;
  }

  /* A whole page with a Footer: what the system does for <body>, done here for the wrapper, so a
     short page still ends with the footer at the bottom of the window. */
  .example--bare:has(> :global(.ds-footer)) {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }

  /* The system keeps the scrollbar's space on every page. An example that never scrolls would
     keep an empty strip at the right instead, showing the docs page behind the iframe. */
  :global(html) {
    scrollbar-gutter: auto;
  }

  /* A whole-page example scrolls; its scrollbar's track is see-through, so the page's own ground
     goes under it rather than the docs page behind the iframe. */
  :global(html) {
    background: var(--surface-canvas);
  }

  /* The theme switch of an example opened on its own, out of the way in a corner. */
  .example-theme {
    background: var(--surface-card);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-pill);
    bottom: var(--space-md);
    box-shadow: var(--shadow-float);
    color: var(--text-ink);
    cursor: pointer;
    font: var(--button-weight) var(--button-size) / 1 var(--font-sans);
    padding: var(--space-xs) var(--space-md);
    position: fixed;
    right: var(--space-md);
    z-index: 100;
  }

  .example-theme[hidden] {
    display: none;
  }

  /* In development, Astro's toolbar belongs on the docs page, not in every example. */
  :global(astro-dev-toolbar) {
    display: none !important;
  }

  /* Examples stack their parts with the same gap, whatever the components' own margins are. */
  .example:not(.example--bare) > :global(* + *) {
    margin-top: var(--space-md);
  }

  .example > :global(:first-child) {
    margin-top: 0;
  }

  .example > :global(:last-child) {
    margin-bottom: 0;
  }
</style>
